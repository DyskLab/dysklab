---
/*
  DyskLink product page. Look: device-ecosystem keynote — near-black navy, teal signal
  glow, Sora headlines, a Mac and a phone joined by pulsing rings. Downloads for the
  computer (Mac, Windows, Linux) and for the phone (Android), because the phone features
  need both apps.
  Every feature has a picture: a real screenshot (rendered by the Mac app's --snapshot
  mode, in /images/products/dysklink/f/) or a small HTML/CSS scene from LinkIllo.
*/
import Base from "../layouts/Base.astro";
import ProductBar from "../components/ProductBar.astro";
import ProductFooter from "../components/ProductFooter.astro";
import Privacy from "../components/Privacy.astro";
import Faq from "../components/Faq.astro";
import Support from "../components/Support.astro";
import LinkIllo from "../components/LinkIllo.astro";
import { ui, type Lang } from "../i18n";
import { download } from "../lib/releases";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (id: string, en: string) => (lang === "id" ? id : en);
const nt = ui[lang].newTab;

const mac = "https://github.com/DyskLab/dysklink-mac";
const android = "https://github.com/DyskLab/dysklink-android";
const macDl = await download("DyskLab/dysklink-mac", /mac.*\.zip$/i);
const androidDl = await download("DyskLab/dysklink-android", /\.apk$/i);
const desktop = "https://github.com/DyskLab/dysklink-desktop";
const winDl = await download("DyskLab/dysklink-desktop", /windows.*\.msi$/i);
const linuxDl = await download("DyskLab/dysklink-desktop", /linux.*\.deb$/i);
const img = (n: string) => `/images/products/dysklink/${n}.jpg`;
const f = (n: string) => `/images/products/dysklink/f/${n}.jpg`;
const shot = t("Tangkapan layar DyskLink", "DyskLink screenshot");

type Item = { t: string; d: string; src?: string; fit?: string; il?: string; i?: string; k?: string[] };
const icon = (d: string) => `<path d="${d}"/>`;

