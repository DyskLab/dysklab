  description={T.description}
  path={Astro.url.pathname}
  ogImage="/images/products/dyskflow/og.jpg"
  ogTitle="DyskFlow"
  fonts="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  theme="light"
  themeColor="#f5efe6"
>
  <div class="fl" id="top">
    <ProductBar
      lang={lang}
      repo="DyskLab/dyskflow"
      name="DyskFlow"
      icon="/images/apps/dyskflow.svg"
      links={[
        { href: "#builder", label: "Page builder" },
        { href: "#pasang", label: T.nav.install },
        { href: "#fitur", label: T.nav.features },
        { href: "#privasi", label: ui[lang].privacy },
        { href: "#faq", label: "FAQ" },
      ]}
      cta={{ href: release, label: T.cta, external: true }}
    />

    <main>
      <header class="hero">
        <div class="wrap">
          <div class="tags">
            <span>Laravel 13</span><span>PHP 8.3+</span><span>MySQL / SQLite</span><span>MIT</span>
          </div>
          <h1>{T.h1a}<br /><span class="mark">{T.h1b}</span></h1>
          <div class="hero-row">
            <p class="lede">{T.lede}</p>
            <div class="cta">
              <a class="btn btn-red" href={release} target="_blank" rel="noopener">{T.download}<span class="sr">{nt}</span></a>
              <a class="btn btn-paper" href="#pasang">{T.howInstall}</a>
            </div>
          </div>
          <div class="shots dl-reveal">
            <figure class="box s-site"><img src={img("01-landing")} width="1800" height="1019" alt={T.shotSiteAlt} fetchpriority="high" /><figcaption>{T.shotSite}</figcaption></figure>
            <figure class="box s-dash"><img src={img("02-dasbor")} width="1800" height="1019" alt={T.shotDashAlt} loading="lazy" /><figcaption>{T.shotDash}</figcaption></figure>
          </div>
        </div>
      </header>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-in">
          {[0, 1].map(() => <span>{T.ticker}&nbsp;</span>)}
        </div>
      </div>

      <section id="builder" class="sec">
        <div class="wrap">
          <div class="b-head dl-reveal">
            <p class="kick red">Page builder</p>
            <h2>{T.bH2a}<br />{T.bH2b}</h2>
            <p class="body">{T.bBody}</p>
          </div>

          <div class="box builder dl-reveal" aria-hidden="true">
            <div class="b-top">
              <span class="b-logo">DyskFlow</span>
              <span class="b-page">{T.mock.page}</span>
              <span class="b-lang">{lang === "id" ? <><b>ID</b> EN</> : <><b>EN</b> ID</>}</span>
              <span class="b-dev">▭ ▯ ▮</span>
              <span class="b-draft">{T.mock.draft}</span>
              <span class="b-pub">Publish</span>
            </div>
            <div class="b-body">
              <aside class="b-side">
                <div class="b-search">{T.mock.search}</div>
                <p class="b-grp">{T.mock.basic}</p>
                <div class="b-wg"><span>H</span>Heading</div><div class="b-wg"><span>¶</span>Text</div><div class="b-wg"><span>▣</span>Image</div><div class="b-wg"><span>◉</span>Button</div>
                <p class="b-grp">{T.mock.interactive}</p>
                <div class="b-wg"><span>⧉</span>Tabs</div><div class="b-wg"><span>≡</span>Accordion</div><div class="b-wg"><span>⏱</span>Countdown</div><div class="b-wg"><span>✉</span>Form</div>
              </aside>
              <div class="b-canvas">
                <div class="b-sec b-hero">
                  <span class="b-label">Section</span>
                  <div class="b-col b-c7">
                    <i class="ln w40 accent"></i><i class="ln big w90"></i><i class="ln big w70"></i><i class="ln w80"></i><i class="ln w60"></i>
                    <span class="b-btn">{T.mock.order}</span>
                  </div>
                  <div class="b-col b-c5 b-img"><span>▣</span></div>
                </div>
                <div class="b-sec b-three">
                  <div class="b-col sel"><span class="b-tag">Icon box</span><i class="dot"></i><i class="ln w70"></i><i class="ln w90"></i></div>
                  <div class="b-col"><i class="dot"></i><i class="ln w60"></i><i class="ln w90"></i></div>
                  <div class="b-col"><i class="dot"></i><i class="ln w80"></i><i class="ln w70"></i></div>
                </div>
                <div class="b-drop">{T.mock.drop}</div>
              </div>
              <aside class="b-props">
                <p class="b-ptitle">Icon box</p>
                <div class="b-tabs"><b>{T.mock.tabs[0]}</b><span>{T.mock.tabs[1]}</span><span>{T.mock.tabs[2]}</span></div>
                <label>{T.mock.lTitle}</label><div class="b-in">{T.mock.vTitle}</div>
                <label>{T.mock.lText}</label><div class="b-in">{T.mock.vText}</div>
                <label>{T.mock.lIcon}</label><div class="b-in">truck</div>
                <label>{T.mock.lAlign}</label><div class="b-seg"><b>⇤</b><span>↔</span><span>⇥</span></div>
              </aside>
            </div>
          </div>

          <ul class="b-points">
            {T.points.map((p) => <li class="dl-reveal"><b>{p.t}</b>{p.d}</li>)}
            <li class="dl-reveal"><b>{T.aiT}</b><code>builder:export</code> {T.and} <code>builder:import</code> {T.aiD}</li>
          </ul>

          <div class="wall dl-reveal">
            <div class="wall-n"><span>65</span>{T.wall}</div>
            <ul class="chips">
              {widgets.map((w) => <li>{w}</li>)}
              <li class="more">{T.more}</li>
            </ul>
          </div>

          <div class="starters dl-reveal">
            <h3>{T.startersH}</h3>
            <p>{T.startersP}</p>
            <ul>{T.starters.map((t, i) => <li class={`st st-${(i % 4) + 1}`}><span aria-hidden="true"></span>{t}</li>)}</ul>
          </div>

          <ul class="design">
            {T.design.map((d) => (
              <li class="box dl-reveal"><h3>{d.t}</h3><p>{d.d}</p></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="pasang" class="sec sec-cream">
        <div class="wrap">
          <h2 class="dl-reveal">{T.installH2a}<br />{T.installH2b}</h2>
          <ol class="steps">
            {T.install.map((s, i) => (
              <li class="box step dl-reveal">
                <span class="big">{i + 1}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="landing" class="sec sec-ink">
        <div class="wrap split">
          <div class="dl-reveal">
            <p class="kick">{T.landK}</p>
            <h2>{T.landH2a}<br />{T.landH2b}</h2>
            <p class="body">{T.landBody1} <code>landing/</code>{lang === "id" ? ". " : " "}{T.landBody2}</p>
          </div>
          <pre class="box tree dl-reveal" aria-label={T.treeLabel}><code><span class="r">{T.treeRoot}</span>
├── <b>landing/</b>        <i>{T.tree.landing}</i>
├── <b>plugins/</b>        <i>{T.tree.plugins}</i>
├── <b>theme/</b>          <i>{T.tree.theme}</i>
├── public/uploads/  <i>{T.tree.uploads}</i>
├── storage/
├── .env
└── cms.json</code></pre>
        </div>
      </section>

      <section id="update" class="sec">
        <div class="wrap split">
          <div class="dl-reveal">
            <p class="kick red">{T.updK}</p>
            <h2>{T.updH2a}<br />{T.updH2b}</h2>
            <ol class="flow">
              {T.update.map((u, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{u}</li>)}
            </ol>
          </div>
          <div class="box keep dl-reveal">
            <p class="keep-t">{T.keepT}</p>
            <ul>{keep.map((k) => <li><code>{k}</code></li>)}</ul>
            <p class="keep-n">{T.keepN1} <code>vendor.zip</code>{T.keepN2}</p>
          </div>
        </div>
      </section>

      <section id="fitur" class="sec sec-cream">
        <div class="wrap">
          <h2 class="dl-reveal">{T.featH2a}<br />{T.featH2b}</h2>
          <ul class="feats">
            {T.features.map((f) => (
              <li class="box feat dl-reveal">
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="sec">
        <div class="wrap">
          <div class="box final dl-reveal">
            <h2>{T.finalH}</h2>
            <p>{T.finalP1} <b>{T.finalBtn}</b>{T.finalP2} <code>SETUP.md</code>.</p>
            <div class="cta">
              <a class="btn btn-paper" href={release} target="_blank" rel="noopener">{T.finalDl}<span class="sr">{nt}</span></a>
              <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">{T.finalCode}<span class="sr">{nt}</span></a>
            </div>
          </div>
        </div>
      </section>

      <Privacy lang={lang} id="privasi" summary={T.pvSummary} items={T.pv} note={T.pvNote} />
      <Faq lang={lang} id="faq" items={T.faq} />
      <Support lang={lang} product="DyskFlow" repos={[{ repo: "DyskLab/dyskflow" }]} />
    </main>

    <ProductFooter lang={lang} current="dyskflow" />
  </div>
  <script src="../scripts/reveal.js"></script>
</Base>

<style>
  :global(body) { margin: 0; background: #f5efe6; }
  .fl {
    --cream: #f5efe6; --cream-2: #ece3d4; --ink: #1a1714; --muted: #5d554c; --red: #e8412c; --yellow: #ffd23f;
    --pb-bg: var(--cream); --pb-fg: var(--ink); --pb-muted: var(--muted); --pb-line: var(--ink); --pb-hover: var(--cream-2);
    --pb-btn-bg: var(--red); --pb-btn-fg: #fff; --pb-radius: 6px; --pb-font: "Bricolage Grotesque", sans-serif;
    --pf-line: var(--ink); --pf-muted: var(--muted); --pf-fg: var(--ink); --pf-card: #fffaf2; --pf-hover: var(--red); --pf-radius: 8px;
    background: var(--cream); color: var(--ink); font: 400 16.5px/1.6 "Bricolage Grotesque", system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  .wrap { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
  .sr, .fl :global(.sr) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1, h2, h3 { margin: 0; font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; }
  code { font: 500 0.88em "IBM Plex Mono", monospace; background: rgba(26, 23, 20, 0.08); padding: 1px 6px; border-radius: 4px; }
  .box { border: 2.5px solid var(--ink); border-radius: 10px; background: #fffaf2; box-shadow: 6px 6px 0 var(--ink); }

  .btn { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border: 2.5px solid var(--ink); border-radius: 8px; font-weight: 600; font-size: 16px; text-decoration: none; color: var(--ink); box-shadow: 4px 4px 0 var(--ink); transition: transform 0.12s, box-shadow 0.12s; }
  .btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }
  .btn:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }
  .btn-red { background: var(--red); color: #fff; }
  .btn-paper { background: #fffaf2; }
  .btn-ghost { background: transparent; color: #fff; border-color: #fff; box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35); }

  .hero { padding: 64px 0 72px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags span { font: 500 13px "IBM Plex Mono", monospace; padding: 5px 10px; border: 2px solid var(--ink); border-radius: 999px; background: #fffaf2; }
  h1 { margin-top: 26px; font-size: clamp(54px, 10vw, 140px); }
  .mark { position: relative; color: var(--red); }
  .hero-row { margin-top: 30px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
  .lede { margin: 0; max-width: 620px; font-size: 20px; color: var(--muted); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .shots { position: relative; margin-top: 56px; display: grid; grid-template-columns: 1.15fr 1fr; gap: 0; }
  .shots figure { margin: 0; overflow: hidden; position: relative; }
  .shots img { width: 100%; height: auto; display: block; }
  .shots figcaption { position: absolute; left: 12px; top: 12px; font: 600 12px "IBM Plex Mono", monospace; padding: 4px 9px; background: var(--yellow); border: 2px solid var(--ink); border-radius: 5px; }
  .s-site { transform: rotate(-1.5deg); z-index: 1; }
  .s-dash { transform: rotate(1.8deg) translate(-40px, 50px); z-index: 2; }

  .ticker { border-top: 2.5px solid var(--ink); border-bottom: 2.5px solid var(--ink); background: var(--yellow); overflow: hidden; padding: 14px 0; }
  .ticker-in { display: flex; width: max-content; animation: tick 32s linear infinite; font-weight: 800; font-size: 22px; letter-spacing: -0.02em; white-space: nowrap; }
  @keyframes tick { to { transform: translateX(-50%); } }

  .sec { padding: 104px 0; }
  h2 { font-size: clamp(38px, 5.6vw, 72px); }
  .steps { list-style: none; margin: 52px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .step { padding: 28px; }
  .big { display: block; font-size: 88px; line-height: 0.8; font-weight: 800; color: var(--red); -webkit-text-stroke: 2.5px var(--ink); }
  .step h3 { margin-top: 22px; font-size: 28px; }
  .step p { margin: 10px 0 0; color: var(--muted); }

  .sec-ink { background: var(--ink); color: var(--cream); }
  .sec-ink .body { color: #cfc6b8; }
  .sec-ink code { background: rgba(245, 239, 230, 0.12); color: var(--cream); }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .kick { margin: 0 0 16px; font: 600 13px "IBM Plex Mono", monospace; text-transform: uppercase; letter-spacing: 0.08em; color: var(--yellow); }
  .kick.red { color: var(--red); }
  .body { margin: 20px 0 0; font-size: 18px; color: var(--muted); }
  .tree { margin: 0; padding: 28px; background: var(--cream); color: var(--ink); box-shadow: 8px 8px 0 var(--red); border-color: var(--cream); overflow-x: auto; font: 400 15px/1.8 "IBM Plex Mono", monospace; }
  .tree code { all: unset; }
  .tree b { color: var(--red); }
  .tree i { font-style: normal; color: #8a7f72; }
  .tree .r { font-weight: 600; }

  .flow { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 10px; }
  .flow li { display: flex; align-items: center; gap: 14px; font-size: 18px; font-weight: 600; padding: 12px 16px; border: 2px solid var(--ink); border-radius: 8px; background: #fffaf2; }
  .flow span { font: 600 13px "IBM Plex Mono", monospace; color: #fff; background: var(--ink); padding: 3px 7px; border-radius: 4px; }
  .keep { padding: 30px; background: var(--yellow); }
  .keep-t { margin: 0; font-weight: 800; font-size: 26px; letter-spacing: -0.02em; }
  .keep ul { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .keep li code { display: inline-block; font-size: 15px; padding: 7px 11px; background: #fffaf2; border: 2px solid var(--ink); border-radius: 6px; }
  .keep-n { margin: 18px 0 0; font-size: 15.5px; }

  .sec-cream { background: var(--cream-2); border-top: 2.5px solid var(--ink); border-bottom: 2.5px solid var(--ink); }
  .feats { list-style: none; margin: 52px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .feat { padding: 22px; transition: transform 0.15s, box-shadow 0.15s, background 0.15s; }
  .feat:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ink); background: #fff; }
  .feat h3 { font-size: 21px; letter-spacing: -0.02em; }
  .feat p { margin: 8px 0 0; font-size: 15px; color: var(--muted); }


  /* page builder */
  .b-head { max-width: 760px; }
  .builder { margin-top: 48px; overflow: hidden; background: #fffaf2; box-shadow: 10px 10px 0 var(--ink); font-size: 13px; }
  .b-top { display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-bottom: 2.5px solid var(--ink); background: var(--ink); color: var(--cream); font-weight: 600; }
  .b-logo { color: var(--red); font-weight: 800; }
  .b-page { color: #b9afa2; }
  .b-lang { margin-left: auto; font: 500 12px "IBM Plex Mono", monospace; padding: 3px 8px; border: 1px solid #5d554c; border-radius: 5px; }
  .b-lang b { color: var(--yellow); }
  .b-dev { letter-spacing: 4px; color: #b9afa2; }
  .b-draft { font-size: 12px; color: #9ee6a8; }
  .b-pub { padding: 5px 14px; border-radius: 5px; background: var(--red); color: #fff; }
  .b-body { display: grid; grid-template-columns: 200px 1fr 220px; min-height: 420px; }
  .b-side, .b-props { padding: 14px; background: #f1e9db; }
  .b-side { border-right: 2.5px solid var(--ink); }
  .b-props { border-left: 2.5px solid var(--ink); }
  .b-search { padding: 7px 10px; border: 2px solid var(--ink); border-radius: 6px; background: #fffaf2; color: var(--muted); }
  .b-grp { margin: 14px 0 8px; font: 600 11px "IBM Plex Mono", monospace; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .b-side { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; align-content: start; }
  .b-search, .b-grp { grid-column: span 2; }
  .b-wg { display: grid; justify-items: center; gap: 4px; padding: 10px 4px; border: 2px solid var(--ink); border-radius: 6px; background: #fffaf2; font-size: 11.5px; font-weight: 600; }
  .b-wg span { font-size: 16px; color: var(--red); }
  .b-canvas { padding: 22px; display: grid; gap: 16px; align-content: start; background: repeating-linear-gradient(0deg, transparent 0 23px, rgba(26, 23, 20, 0.05) 23px 24px), #fffaf2; }
  .b-sec { position: relative; display: grid; gap: 14px; padding: 18px; border: 2px dashed #c9bda9; border-radius: 8px; background: #fff; }
  .b-label { position: absolute; left: -2px; top: -12px; font: 600 10.5px "IBM Plex Mono", monospace; padding: 2px 7px; border-radius: 4px; background: var(--ink); color: var(--cream); }
  .b-hero { grid-template-columns: 7fr 5fr; align-items: center; }
  .b-col { position: relative; display: grid; gap: 7px; align-content: start; padding: 12px; border-radius: 6px; }
  .b-three { grid-template-columns: repeat(3, 1fr); }
  .b-three .b-col { border: 1.5px solid #ece3d4; }
  .b-col.sel { border: 2.5px solid var(--red); box-shadow: 4px 4px 0 var(--red); }
  .b-tag { position: absolute; right: -2px; top: -12px; font: 600 10.5px "IBM Plex Mono", monospace; padding: 2px 7px; border-radius: 4px; background: var(--red); color: #fff; }
  .ln { display: block; height: 7px; border-radius: 4px; background: #e2d8c7; }
  .ln.big { height: 16px; background: var(--ink); }
  .ln.accent { background: var(--red); height: 6px; }
  .w40 { width: 40%; } .w60 { width: 60%; } .w70 { width: 70%; } .w80 { width: 80%; } .w90 { width: 90%; }
  .dot { width: 26px; height: 26px; border-radius: 8px; background: var(--yellow); border: 2px solid var(--ink); }
  .b-btn { justify-self: start; margin-top: 6px; padding: 6px 12px; border-radius: 5px; background: var(--red); color: #fff; font-weight: 700; font-size: 12px; }
  .b-img { min-height: 130px; display: grid !important; place-items: center; background: repeating-linear-gradient(45deg, #ffe58a 0 10px, #ffd23f 10px 20px); border: 2px solid var(--ink); font-size: 28px; }
  .b-drop { padding: 14px; text-align: center; border: 2px dashed var(--red); border-radius: 8px; color: var(--red); font-weight: 700; background: rgba(232, 65, 44, 0.05); }
  .b-ptitle { margin: 0 0 10px; font-weight: 800; font-size: 15px; }
  .b-tabs { display: flex; gap: 4px; margin-bottom: 12px; font-size: 11.5px; }
  .b-tabs > * { flex: 1; text-align: center; padding: 5px 0; border-radius: 5px; border: 1.5px solid var(--ink); background: #fffaf2; }
  .b-tabs b { background: var(--ink); color: var(--cream); }
  .b-props label { display: block; margin: 10px 0 4px; font: 600 11px "IBM Plex Mono", monospace; color: var(--muted); }
  .b-in { padding: 6px 9px; border: 2px solid var(--ink); border-radius: 5px; background: #fffaf2; font-weight: 600; }
  .b-seg { display: flex; border: 2px solid var(--ink); border-radius: 5px; overflow: hidden; }
  .b-seg > * { flex: 1; text-align: center; padding: 4px 0; background: #fffaf2; }
  .b-seg b { background: var(--yellow); }
  .b-points { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .b-points li { padding-top: 14px; border-top: 3px solid var(--ink); color: var(--muted); font-size: 15px; }
  .b-points b { display: block; margin-bottom: 4px; color: var(--ink); font-size: 18px; letter-spacing: -0.02em; }
  .wall { margin-top: 72px; display: grid; grid-template-columns: 260px 1fr; gap: 36px; align-items: center; }
  .wall-n { font-weight: 600; font-size: 18px; line-height: 1.3; }
  .wall-n span { display: block; font-size: 120px; line-height: 0.85; font-weight: 800; letter-spacing: -0.05em; color: var(--red); -webkit-text-stroke: 2.5px var(--ink); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 6px 12px; border: 2px solid var(--ink); border-radius: 999px; background: #fffaf2; font-weight: 600; font-size: 14px; }
