---
/* DyskStream product page: purple, open source. Screenshots from the repo's docs/screenshots. */
import ProductSimple from "../components/ProductSimple.astro";
import { pick, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = <T,>(id: T, en: T): T => pick(lang, { id, en });
const img = (n: string) => `/images/products/dyskstream/${n}.jpg`;

const shots = [
  { src: img("overlay"), t: s("Overlay dan scene", "Overlays and scenes"), d: s("URL Browser Source untuk OBS, plus scene segera mulai, istirahat, dan selesai.", "Browser Source URLs for OBS, plus starting soon, be right back and ended scenes."), alt: s("Halaman overlay DyskStream", "The DyskStream overlay page") },
  { src: img("templates"), t: s("Template alert", "Alert templates"), d: s("Command, biaya point, animasi, posisi, warna, gambar, suara, dan TTS per alert, dengan Test Alert.", "Command, point cost, animation, position, colours, image, sound and TTS per alert, with Test Alert."), alt: s("Editor template alert DyskStream", "The DyskStream alert template editor") },
  { src: img("giveaway"), t: s("Giveaway dan kuis", "Giveaways and quizzes"), d: s("Penonton yang mengetik kata syarat jadi peserta undian. Yang pertama menjawab kuis dengan benar dapat point.", "Viewers who type the keyword enter the draw. The first right answer to a quiz earns points."), alt: s("Giveaway dan kuis di DyskStream", "Giveaways and quizzes in DyskStream") },
  { src: img("overlays"), t: s("Di atas stream", "On the stream"), d: s("Alert yang ditukar penonton muncul satu per satu, dan avatar penonton yang sedang chat berjalan di bawah.", "Alerts viewers buy appear one at a time, and avatars of viewers who are chatting walk along the bottom."), alt: s("Alert dan avatar penonton DyskStream di OBS", "A DyskStream alert and viewer avatars in OBS") },
];

const features = [
  { t: s("Baca live chat tanpa login", "Reads live chat with no login"), d: s("Tempel URL atau ID video live dari channel publik mana pun. Tanpa OAuth, API key, atau kuota.", "Paste the URL or ID of any public live video. No OAuth, API key or quota.") },
  { t: s("Sistem point", "Points"), d: s("+1 point per komentar dengan cooldown supaya spam tidak dihitung, bonus command, dan leaderboard.", "+1 point per comment with a cooldown so spam doesn't count, bonus commands and a leaderboard.") },
  { t: "!alert", d: s("Penonton menukar point jadi alert ala Saweria di OBS, dengan gambar, suara, atau TTS sendiri. Antriannya satu per satu, jadi tidak menumpuk.", "Viewers spend points on Saweria-style alerts in OBS with your own image, sound or TTS, queued one at a time so they never pile up.") },
  { t: s("Overlay OBS", "OBS overlays"), d: s("Alert, live chat, leaderboard, ticker, antrian request, running text, goal bar, dan avatar penonton.", "Alerts, live chat, leaderboard, ticker, request queue, running text, a goal bar and viewer avatars.") },
  { t: s("Scene layar penuh", "Full-screen scenes"), d: s("Segera dimulai, istirahat sebentar, dan stream selesai.", "Starting soon, be right back and stream ended.") },
  { t: s("Dasbor dan soundboard", "Dashboard and soundboard"), d: s("Monitor, leaderboard, aturan, editor template dengan Test Alert, dan soundboard dengan hotkey. Bisa dibuka di HP lewat QR.", "Monitor, leaderboard, rules, a template editor with Test Alert, and a soundboard with hotkeys. Open it on your phone with a QR code.") },
];
---
<ProductSimple
  lang={lang}
  slug="dyskstream"
  name="DyskStream"
  repo="DyskLab/dyskstream"
  accent="#a855f7"
  title={s("DyskStream: asisten YouTube Live dengan point dan alert OBS | DyskLab", "DyskStream: a YouTube Live assistant with points and OBS alerts | DyskLab")}
  description={s(
    "DyskStream membaca live chat YouTube tanpa login, memberi point ke penonton yang komen, dan menukarnya jadi alert di OBS. Gratis dan open source.",
    "DyskStream reads YouTube live chat with no login, gives viewers points for chatting and turns them into alerts in OBS. Free and open source.",
  )}
  pillTag={s("Baru", "New")}
  pill="Web · macOS · Windows"
  h1={s(["Chat jadi point,", "point jadi alert."], ["Chat earns points,", "points buy alerts."])}
  lede={s(
    "Bot YouTube Live yang Anda jalankan sendiri. Penonton dapat point dari setiap komentar dan menukarnya dengan alert yang muncul di OBS. Balasan command dan moderasi diserahkan ke Nightbot.",
    "A YouTube Live bot you run yourself. Viewers earn points for every comment and spend them on alerts that pop up in OBS. Command replies and moderation are left to Nightbot.",
  )}
  chips={["YouTube Live", "OBS", "Nightbot", s("Aplikasi desktop", "Desktop app")]}
  hero={{ src: img("monitor"), t: "", d: "", alt: s("Dasbor monitor DyskStream", "The DyskStream monitor dashboard") }}
  shots={shots}
  views={{ kick: s("Tampilan", "Views"), h: s("Dari dasbor sampai OBS.", "From the dashboard to OBS.") }}
  featH={s("Semua yang dibutuhkan stream interaktif.", "Everything an interactive stream needs.")}
  features={features}
  panel={{
    kick: s("Cara kerja", "How it works"),
    h: s("Tidak pernah posting ke chat.", "It never posts to chat."),
    items: [
      s("Chat dibaca lewat masterchat, tanpa akun YouTube.", "Chat is read through masterchat, with no YouTube account."),
      s("Command yang butuh balasan (!point, !rank) dijalankan Nightbot lewat $(urlfetch).", "Commands that need a reply (!point, !rank) run in Nightbot through $(urlfetch)."),
      s("Dasbor dilindungi password; overlay dan endpoint Nightbot tetap publik karena OBS dan Nightbot membutuhkannya.", "The dashboard is password protected; overlays and Nightbot endpoints stay public because OBS and Nightbot need them."),
    ],
  }}
  get={{
    h: s("Jalan 24/7 di satu port.", "Runs 24/7 on one port."),
    p: s("Pakai Docker atau PM2 di server, atau build aplikasi desktop untuk Mac dan Windows. Butuh Node.js 25 atau lebih baru.", "Use Docker or PM2 on a server, or build the desktop app for Mac and Windows. Needs Node.js 25 or later."),
    code: `git clone https://github.com/DyskLab/dyskstream.git
cd dyskstream
echo "ADMIN_PASSWORD=your-password" > .env
docker compose up -d --build
# open http://localhost:4300`,
  }}
  platforms={["Web (Docker/PM2)", "macOS", "Windows"]}
/>
