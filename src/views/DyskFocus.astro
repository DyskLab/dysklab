---
/*
  DyskFocus product page. Look: bright, friendly "bento" — soft lilac canvas, white rounded
  tiles, violet + lime accents, Plus Jakarta Sans. The hero is a real, tickable Today list
  (HTML, not a screenshot) so the page feels like the app before any picture loads.
  Bilingual: every string goes through s(id, en). The quick-add example stays in English in
  both languages, because that is the parser's documented syntax.
*/
import Base from "../layouts/Base.astro";
import ProductBar from "../components/ProductBar.astro";
import ProductFooter from "../components/ProductFooter.astro";
import Privacy from "../components/Privacy.astro";
import Faq from "../components/Faq.astro";
import Support from "../components/Support.astro";
import { pick, ui, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = <T,>(id: T, en: T): T => pick(lang, { id, en });
const nt = ui[lang].newTab;

const repo = "https://github.com/DyskLab/dyskfocus";
const release = `${repo}/releases/latest`;
const img = (n: string) => `/images/products/dyskfocus/${n}.jpg`;

const work = s("Kerja", "Work");
const home = s("Rumah", "Home");
const todayDue = s("Hari ini", "Today");
const today = [
  { t: s("Kirim invoice ke klien", "Send the client invoice"), tag: work, c: "v", due: todayDue, flag: true, done: true },
  { t: s("Bayar listrik", "Pay the power bill"), tag: home, c: "o", due: todayDue, flag: false, done: false },
  { t: s("Review draft proposal", "Review the proposal draft"), tag: work, c: "v", due: s("Besok", "Tomorrow"), flag: true, done: false },
  { t: s("Siram tanaman", "Water the plants"), tag: home, c: "o", due: s("Berulang", "Repeats"), flag: false, done: false },
];

const viewAlt = (v: string) => s(`Tampilan ${v} di DyskFocus`, `The ${v} view in DyskFocus`);
const views = [
  { id: "today", label: "Today", src: img("01-today"), alt: viewAlt("Today") },
  { id: "inbox", label: "Inbox", src: img("02-inbox"), alt: viewAlt("Inbox") },
  { id: "forecast", label: "Forecast", src: img("03-forecast"), alt: viewAlt("Forecast") },
  { id: "calendar", label: "Calendar", src: img("04-calendar"), alt: viewAlt("Calendar") },
];

const forms = [
  {
    t: s("Aplikasi web", "Web app"),
    d: s("Pasang di server sendiri. Laravel menyajikan aplikasi React lewat API di domain yang sama.", "Host it on your own server. Laravel serves the React app over an API on the same domain."),
    i: "M3 5h18v12H3zM8 21h8M12 17v4",
  },
  {
    t: "PWA",
    d: s("Pasang dari browser ke layar utama HP atau desktop, lengkap dengan pengingat web push.", "Install it from the browser to your phone or desktop home screen, with web push reminders."),
    i: "M8 2h8v20H8zM11 18h2",
  },
  {
    t: s("Aplikasi macOS", "macOS app"),
    d: s("Satu file .app yang membawa PHP dan SQLite sendiri. Tidak perlu server sama sekali.", "One .app that brings its own PHP and SQLite. No server needed at all."),
    i: "M4 5h16v11H4zM2 19h20",
  },
];

const privacy = {
  summary: s("Tugas Anda tinggal di server Anda sendiri, atau di Mac Anda.", "Your tasks live on your own server, or on your Mac."),
  items: [
    {
      t: s("Database milik Anda", "Your own database"),
      d: s(
        "Versi self-hosted menyimpan semuanya di file SQLite di server Anda (<code>database/database.sqlite</code>). Aplikasi Mac menyimpannya di <code>~/Library/Application Support/DyskFocus</code>.",
        "The self-hosted version keeps everything in a SQLite file on your server (<code>database/database.sqlite</code>). The Mac app keeps it in <code>~/Library/Application Support/DyskFocus</code>.",
      ),
    },
    {
      t: s("Tidak ada server DyskLab", "No DyskLab server"),
      d: s(
        "Akun dibuat di instance Anda sendiri, bukan di layanan kami. DyskLab tidak pernah melihat tugas, akun, atau kata sandi Anda.",
        "Your account is created on your own instance, not on a service of ours. DyskLab never sees your tasks, account or password.",
      ),
    },
    {
      t: s("Tanpa analitik dan telemetri", "No analytics or telemetry"),
      d: s(
        "Tidak ada skrip pelacak, font, atau CDN dari pihak lain. Aplikasi hanya memuat file dari domain Anda sendiri.",
        "No tracking scripts, and no third-party fonts or CDNs. The app only loads files from your own domain.",
      ),
    },
    {
      t: s("Aplikasi Mac sepenuhnya lokal", "The Mac app stays local"),
      d: s(
        "Server PHP bawaannya hanya mendengarkan di <code>127.0.0.1</code>, dan tidak ada pemeriksaan update otomatis. Bisa dipakai tanpa internet.",
        "Its bundled PHP server only listens on <code>127.0.0.1</code>, and there is no automatic update check. It works without internet.",
      ),
    },
    {
      t: s("Web push lewat layanan browser", "Web push goes through the browser vendor"),
      d: s(
        "Kalau Anda mengaktifkan pengingat push, server Anda mengirim notifikasi terenkripsi (berisi judul tugas) lewat layanan push milik pembuat browser, seperti Google, Mozilla, atau Apple. Opsional, dan mati di aplikasi Mac.",
        "If you turn on push reminders, your server sends an encrypted notification (with the task title) through your browser vendor's push service, such as Google, Mozilla or Apple. Optional, and off in the Mac app.",
      ),
      ok: false,
    },
    {
      t: s("Keamanan server dan cadangan jadi tanggung jawab Anda", "Server security and backups are on you"),
      d: s(
        "Pasang HTTPS dan jaga server Anda. File cadangan JSON berisi semua data tanpa enkripsi, jadi simpan dengan hati-hati.",
        "Use HTTPS and keep your server patched. A JSON backup holds all your data unencrypted, so store it with care.",
      ),
      ok: false,
    },
  ],
  note: s(
    `Semua ini bisa Anda periksa sendiri di <a href="${repo}" target="_blank" rel="noopener">kode sumbernya</a>.`,
    `You can check all of this in the <a href="${repo}" target="_blank" rel="noopener">source code</a>.`,
  ),
};

const xattr = "<code>xattr -dr com.apple.quarantine /Applications/DyskFocus.app</code>";
const faq = s(
  [
    {
      q: "Apakah DyskFocus jalan di Windows atau Linux?",
      a: "<p>Ya, lewat web. Pasang versi self-hosted di server mana pun, lalu buka dari browser di Windows, Linux, macOS, atau HP, dan pasang sebagai PWA kalau mau. Aplikasi native hanya ada untuk macOS.</p>",
    },
    {
      q: "Bisa dipakai di HP?",
      a: "<p>Bisa. Buka instance Anda di browser HP dan tambahkan ke layar utama sebagai PWA. Tampilannya punya gestur geser, aksi massal, dan bottom sheet, dan pengingat web push bisa datang ke HP.</p>",
    },
    {
      q: "Ada versi untuk Mac Intel?",
      a: `<p>Rilis resmi hanya untuk Apple Silicon. Di Mac Intel Anda bisa membangunnya sendiri dengan PHP statis x86_64 dan <code>npm run dist:x64</code>, lihat <a href="${repo}/blob/main/desktop.md" target="_blank" rel="noopener">desktop.md</a>. Atau pakai versi web.</p>`,
    },
    {
      q: "macOS bilang aplikasinya tidak bisa dibuka. Kenapa?",
      a: `<p>Aplikasinya belum dinotarisasi Apple, jadi macOS memblokir peluncuran pertama. Buka <b>System Settings › Privacy &amp; Security</b> dan pilih <b>Open Anyway</b>, atau jalankan ${xattr}.</p>`,
    },
    {
      q: "Apa yang dibutuhkan untuk self-hosting?",
      a: "<p>PHP 8.4 (dengan <code>openssl</code>, <code>mbstring</code>, <code>bcmath</code>, <code>curl</code>), Composer 2, Node 20+ dan npm, serta SQLite. Pengingat push butuh kunci VAPID dan cron untuk <code>php artisan schedule:run</code>.</p>",
    },
    {
      q: "Apakah gratis?",
      a: "<p>Ya. DyskFocus open source dengan lisensi MIT, tanpa iklan, tanpa langganan, dan tanpa versi berbayar.</p>",
    },
    {
      q: "Bagaimana cara mencadangkan atau memindahkan data?",
      a: "<p>Buka <b>Settings › Data › Export backup</b> untuk mengunduh semuanya sebagai JSON. Pulihkan lewat <b>Import backup</b> atau di wizard pertama. Impor <b>mengganti</b> semua data yang ada.</p><p>Kalau sebelumnya memakai Stackr di Mac, datanya disalin otomatis saat DyskFocus pertama dibuka, dan salinan lama tetap di tempatnya.</p>",
    },
    {
      q: "Bisa dipakai beberapa orang?",
      a: "<p>Bisa, di versi self-hosted. Setelah akun pertama dibuat, pendaftaran ditutup. Set <code>ALLOW_REGISTRATION=true</code> agar orang lain bisa mendaftar di instance yang sama, masing-masing dengan datanya sendiri.</p>",
    },
    {
      q: "Menemukan bug atau punya ide?",
      a: `<p>Buka issue di <a href="${repo}/issues" target="_blank" rel="noopener">GitHub</a>. Sertakan versi, cara pakai (web atau Mac), dan langkah untuk mengulang masalahnya.</p>`,
    },
  ],
  [
    {
      q: "Does DyskFocus run on Windows or Linux?",
      a: "<p>Yes, on the web. Host the self-hosted version on any server, then open it in a browser on Windows, Linux, macOS or your phone, and install it as a PWA if you like. The native app is macOS only.</p>",
    },
    {
      q: "Can I use it on my phone?",
      a: "<p>Yes. Open your instance in your phone's browser and add it to the home screen as a PWA. It has swipe gestures, bulk actions and a bottom sheet, and web push reminders can reach your phone.</p>",
    },
    {
      q: "Is there a build for Intel Macs?",
      a: `<p>The official release is Apple Silicon only. On an Intel Mac you can build it yourself with an x86_64 static PHP and <code>npm run dist:x64</code>; see <a href="${repo}/blob/main/desktop.md" target="_blank" rel="noopener">desktop.md</a>. Or use the web version.</p>`,
    },
    {
      q: "macOS says the app can't be opened. Why?",
      a: `<p>The app isn't notarized by Apple yet, so macOS blocks the first launch. Open <b>System Settings › Privacy &amp; Security</b> and choose <b>Open Anyway</b>, or run ${xattr}.</p>`,
    },
    {
      q: "What do I need to self-host it?",
      a: "<p>PHP 8.4 (with <code>openssl</code>, <code>mbstring</code>, <code>bcmath</code>, <code>curl</code>), Composer 2, Node 20+ with npm, and SQLite. Push reminders also need VAPID keys and a cron entry for <code>php artisan schedule:run</code>.</p>",
    },
    {
      q: "Is it free?",
      a: "<p>Yes. DyskFocus is open source under the MIT license, with no ads, no subscription and no paid tier.</p>",
    },
    {
      q: "How do I back up or move my data?",
      a: "<p>Go to <b>Settings › Data › Export backup</b> to download everything as JSON. Restore it with <b>Import backup</b> or in the first-run wizard. Importing <b>replaces</b> all current data.</p><p>If you used Stackr on your Mac, your data is copied over the first time you open DyskFocus, and the old copy stays where it was.</p>",
    },
    {
      q: "Can several people use one instance?",
      a: "<p>Yes, on the self-hosted version. Sign-up closes after the first account is created. Set <code>ALLOW_REGISTRATION=true</code> to let other people register on the same instance, each with their own data.</p>",
    },
    {
      q: "Found a bug or have an idea?",
      a: `<p>Open an issue on <a href="${repo}/issues" target="_blank" rel="noopener">GitHub</a>. Include the version, how you use it (web or Mac), and the steps to reproduce the problem.</p>`,
    },
  ],
);
---

<Base
  title={s(
    "DyskFocus: pengelola tugas self-hosted untuk web, PWA, dan macOS | DyskLab",
    "DyskFocus: a self-hosted task manager for the web, PWA and macOS | DyskLab",
  )}
  description={s(
    "DyskFocus adalah pengelola tugas bergaya OmniFocus yang di-host sendiri: inbox, project, tag, perspektif, review, dan forecast. Tersedia sebagai aplikasi web, PWA, dan aplikasi macOS.",
    "DyskFocus is a self-hosted, OmniFocus-style task manager: inbox, projects, tags, perspectives, review and forecast. Available as a web app, a PWA and a macOS app.",
  )}
  path={Astro.url.pathname}
  ogImage="/images/products/dyskfocus/og.jpg"
  ogTitle="DyskFocus"
  fonts="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  theme="light"
  themeColor="#f3f0ff"
>
  <div class="fo" id="top">
    <ProductBar
      lang={lang}
      repo="DyskLab/dyskfocus"
      name="DyskFocus"
      icon="/images/apps/dyskfocus.png"
      links={[
        { href: "#tampilan", label: s("Tampilan", "Views") },
        { href: "#fitur", label: s("Fitur", "Features") },
        { href: "#mulai", label: s("Mulai", "Get started") },
        { href: "#privasi", label: ui[lang].privacy },
        { href: "#faq", label: "FAQ" },
      ]}
      cta={{ href: release, label: s("Unduh untuk Mac", "Download for Mac"), external: true }}
    />

    <main>
      <header class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="pill"><span>{s("Gratis", "Free")}</span>Web · PWA · macOS</p>
            {lang === "id" ? (
              <h1>Kosongkan kepala.<br /><span class="hl">Biar DyskFocus</span> yang ingat.</h1>
            ) : (
              <h1>Clear your head.<br /><span class="hl">Let DyskFocus</span> remember.</h1>
            )}
            <p class="lede">
              {s(
                "Pengelola tugas bergaya OmniFocus yang sepenuhnya milik Anda. Inbox, project, tag, perspektif, review, dan forecast, di server sendiri atau di Mac tanpa server.",
                "An OmniFocus-style task manager that is entirely yours. Inbox, projects, tags, perspectives, review and forecast, on your own server or on a Mac with no server at all.",
              )}
            </p>
            <div class="cta">
              <a class="btn btn-violet" href="#mulai">{s("Pakai di web", "Use it on the web")}</a>
              <a class="btn btn-white" href={release} target="_blank" rel="noopener">{s("Unduh untuk Mac", "Download for Mac")}<span class="sr">{nt}</span></a>
            </div>
            <ul class="plat" aria-label={s("Platform", "Platforms")}>
              <li><b>Web</b>{s("Semua OS, lewat browser", "Any OS, in the browser")}</li>
              <li><b>PWA</b>{s("HP dan desktop", "Phone and desktop")}</li>
              <li><b>macOS</b>{s("Tanpa server", "No server")}</li>
            </ul>
          </div>

          <div class="board dl-reveal">
            <div class="today">
              <div class="today-head">
                <span class="star" aria-hidden="true">★</span>
                <div><b>Today</b><small>{s("Coba centang tugasnya", "Try ticking a task")}</small></div>
              </div>
              <ul>
                {today.map((t) => (
                  <li>
                    <label class={`task task-${t.c}`}>
                      <input type="checkbox" checked={t.done} />
                      <span class="box" aria-hidden="true"></span>
                      <span class="t">{t.t}</span>
                      <span class="meta">
                        {t.flag && <span class="flag" aria-label={s("Ditandai", "Flagged")}>⚑</span>}
                        <span class="tag">{t.tag}</span>
                        <span class="due">{t.due}</span>
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
            <div class="qa" aria-label={s("Contoh tambah tugas cepat", "Quick add example")}>
              <span class="plus" aria-hidden="true">+</span>
              <span class="typed">Pay rent <mark class="m1">!high</mark> <mark class="m2">#home</mark> <mark class="m3">tomorrow</mark></span>
              <kbd>↵</kbd>
            </div>
            <div class="sticker" aria-hidden="true">{s("Satu kalimat,", "One sentence,")}<br />{s("langsung jadi tugas", "one task")}</div>
          </div>
        </div>
      </header>

      <section id="tampilan" class="sec">
        <div class="wrap">
          <div class="head dl-reveal">
            <h2>{s("Lima cara melihat hari Anda.", "Five ways to see your day.")}</h2>
            <p>{s("Today, Inbox, Forecast, Calendar, plus Flagged dan Completed. Semuanya sadar zona waktu.", "Today, Inbox, Forecast, Calendar, plus Flagged and Completed. All of them timezone-aware.")}</p>
          </div>
          <div class="views dl-reveal" data-views>
            <div class="tabs" role="tablist" aria-label={s("Tampilan DyskFocus", "DyskFocus views")}>
              {views.map((v, i) => (
                <button type="button" role="tab" id={`tab-${v.id}`} aria-controls={`panel-${v.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{v.label}</button>
              ))}
            </div>
            <div class="window">
              <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
              {views.map((v, i) => (
                <div class="panel" role="tabpanel" id={`panel-${v.id}`} aria-labelledby={`tab-${v.id}`} hidden={i !== 0}>
                  <img src={v.src} width="1800" height="1019" alt={v.alt} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="fitur" class="sec sec-tight">
        <div class="wrap">
          <div class="head dl-reveal">
            <h2>{s("Kecil di luar, lengkap di dalam.", "Small on the outside, complete inside.")}</h2>
          </div>
          <div class="bento">
            <article class="tile t-quick dl-reveal">
              <h3>{s("Tambah cepat dengan bahasa biasa", "Quick add in plain language")}</h3>
              <p>{s("Tulis satu kalimat. Prioritas, tag, dan tanggal dikenali sendiri.", "Type one sentence. Priority, tags and dates are picked up for you.")}</p>
              <div class="parse">
                <code>Pay rent !high #home tomorrow</code>
                <div class="chips"><span>{s("Prioritas · Tinggi", "Priority · High")}</span><span>Tag · home</span><span>{s("Due · Besok", "Due · Tomorrow")}</span></div>
              </div>
            </article>
            <article class="tile t-persp dl-reveal">
              <h3>{s("Perspektif dan Review", "Perspectives and Review")}</h3>
              <p>{s("Simpan filter favorit sebagai perspektif, lalu tinjau project satu per satu di mode Review.", "Save your favourite filters as perspectives, then go through projects one by one in Review mode.")}</p>
              <div class="pchips">
                {s(
                  ["Kerja minggu ini", "Menunggu balasan", "Ditandai", "Tanpa tag"],
                  ["Work this week", "Waiting for reply", "Flagged", "Untagged"],
                ).map((c) => <span>{c}</span>)}
              </div>
            </article>
            <article class="tile t-date dl-reveal">
              <span class="big-ic" aria-hidden="true">📅</span>
              <h3>{s("Tanggal yang masuk akal", "Dates that make sense")}</h3>
              <p>{s("Defer dan due date, flag, prioritas, warna tugas, dan tugas berulang.", "Defer and due dates, flags, priorities, task colours and recurring tasks.")}</p>
            </article>
            <article class="tile t-tree dl-reveal">
              <h3>{s("Project dan subtugas", "Projects and subtasks")}</h3>
              {lang === "id" ? (
                <ul class="tree" aria-hidden="true">
                  <li>Pindah rumah<ul><li>Packing dapur</li><li>Urus alamat<ul><li>Bank</li><li>Kantor pos</li></ul></li></ul></li>
                </ul>
              ) : (
                <ul class="tree" aria-hidden="true">
                  <li>Move house<ul><li>Pack the kitchen</li><li>Change address<ul><li>Bank</li><li>Post office</li></ul></li></ul></li>
                </ul>
              )}
              <p>{s("Bertingkat, dan urutannya tinggal diseret.", "Nested as deep as you need, reordered by dragging.")}</p>
            </article>
            <article class="tile t-md dl-reveal">
              <span class="big-ic" aria-hidden="true">✍️</span>
              <h3>{s("Catatan Markdown", "Markdown notes")}</h3>
              <p>{s("Catatan dan komentar lengkap di setiap tugas.", "Full notes and comments on every task.")}</p>
            </article>
            <article class="tile t-sync dl-reveal">
              <h3>{s("Sinkron real-time dan web push", "Real-time sync and web push")}</h3>
              <p>{s("Perubahan langsung muncul di tab lain, dan pengingat datang ke HP atau desktop (versi self-hosted).", "Changes show up in your other tabs right away, and reminders reach your phone or desktop (self-hosted version).")}</p>
              <span class="live"><i></i>{s("Tersinkron", "In sync")}</span>
            </article>
            <article class="tile t-mobile dl-reveal">
              <h3>{s("Nyaman di HP", "Comfortable on a phone")}</h3>
              <p>{s("Aksi massal, gestur geser, dan bottom sheet di layar kecil.", "Bulk actions, swipe gestures and a bottom sheet on small screens.")}</p>
            </article>
            <article class="tile t-backup dl-reveal">
              <h3>{s("Data Anda, kapan saja", "Your data, any time")}</h3>
              <p>{s("Cadangkan dan pulihkan lewat JSON, dengan wizard saat pertama dibuka.", "Back up and restore with JSON, with a setup wizard on first launch.")}</p>
            </article>
            <article class="tile t-strip dl-reveal">
              {s(
                ["Mode gelap", "Pintasan keyboard", "Zona waktu", "Flagged dan Completed"],
                ["Dark mode", "Keyboard shortcuts", "Time zones", "Flagged and Completed"],
              ).map((c) => <span>{c}</span>)}
            </article>
          </div>
        </div>
      </section>

      <section id="bentuk" class="sec sec-tight">
        <div class="wrap">
          <div class="head dl-reveal">
            <h2>{s("Satu kode, tiga bentuk.", "One codebase, three forms.")}</h2>
          </div>
          <ul class="forms">
            {forms.map((f) => (
              <li class="tile dl-reveal">
                <span class="f-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={f.i} /></svg></span>
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="mulai" class="sec">
        <div class="wrap">
          <div class="head dl-reveal">
            <h2>{s("Pilih cara mulai.", "Pick how to start.")}</h2>
          </div>
          <div class="start">
            <article class="tile s-srv dl-reveal">
              <p class="s-k">{s("Web · Windows, Linux, HP", "Web · Windows, Linux, phones")}</p>
              <h3>{s("Di web, server sendiri", "On the web, your own server")}</h3>
              <pre><code>git clone https://github.com/DyskLab/dyskfocus.git
cd dyskfocus && cp .env.example .env
composer install && npm install
npm run build && php artisan key:generate</code></pre>
              <p>{s(
                "Buka aplikasinya, lalu wizard membuat database dan akun Anda, dan bisa mengimpor cadangan. Setelah itu DyskFocus bisa dibuka dari browser di perangkat apa pun, dan dipasang sebagai PWA.",
                "Open the app and a wizard creates the database and your account, and can import a backup. After that, DyskFocus opens in a browser on any device and installs as a PWA.",
              )}</p>
              <a class="btn btn-white" href={repo} target="_blank" rel="noopener">{s("Lihat di GitHub", "View on GitHub")} ↗<span class="sr">{nt}</span></a>
            </article>
            <article class="tile s-mac dl-reveal">
              <p class="s-k">{s("Paling mudah", "Easiest")}</p>
              <h3>{s("Di Mac, tanpa server", "On a Mac, no server")}</h3>
              {lang === "id" ? (
                <p>Unduh DMG dari rilis terbaru dan seret <b>DyskFocus</b> ke Applications. Aplikasi belum dinotarisasi, jadi izinkan
                  lewat <b>Privacy &amp; Security › Open Anyway</b>, atau jalankan:</p>
              ) : (
