---
/*
  DyskOS product page. Deliberately has no download or repository link: DyskOS is shown, not
  distributed. Dark, warm-orange look. Bilingual through s(id, en). Static, no client script.
*/
import Base from "../layouts/Base.astro";
import ProductBar from "../components/ProductBar.astro";
import ProductFooter from "../components/ProductFooter.astro";
import { pick, ui, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = <T,>(id: T, en: T): T => pick(lang, { id, en });
const img = (n: string) => `/images/products/dyskos/${n}.jpg`;

const workers = ["Claude Code", "Codex", "Gemini CLI", "OpenCode", "Hermes"];

const shots = [
  { src: img("01-chat"), t: s("Chat", "Chat"), d: s("Balasan streaming, setiap langkah agen, subagent paralel, dan kartu izin sebelum perintah dijalankan.", "Streamed replies, every step the agent takes, parallel subagents, and permission cards before anything runs."), alt: s("Sesi Claude dengan tiga subagent di DyskOS", "A Claude session with three subagents in DyskOS") },
  { src: img("02-town"), t: "Town", d: s("Kota pixel-art: tiap sesi adalah karakter. Yang bekerja mengetik di mejanya, yang butuh izin berdiri dengan tanda seru.", "A pixel-art town where each session is a character. Working ones type at their desks; one that needs permission stands up with a “!”."), alt: s("Tampilan Town di DyskOS", "The Town view in DyskOS") },
  { src: img("03-agents"), t: s("Agen", "Agents"), d: s("Lima agen dan kuota masing-masing, lengkap dengan login dan model yang tersedia.", "Five agents with their quotas, logins and available models."), alt: s("Daftar agen dan kuota di DyskOS", "The agents and quotas in DyskOS") },
  { src: img("04-inbox"), t: "Inbox", d: s("Permintaan izin, error, dan balasan belum dibaca dari semua sesi di satu tempat.", "Permission requests, errors and unread replies from every session in one place."), alt: s("Inbox di DyskOS", "The Inbox in DyskOS") },
];

const features = [
  { t: s("Lima agen, satu tempat", "Five agents, one place"), d: s("Claude Code, Codex, Gemini CLI, OpenCode, dan Hermes jalan berdampingan, masing-masing dengan sesinya sendiri.", "Claude Code, Codex, Gemini CLI, OpenCode and Hermes run side by side, each with its own session.") },
  { t: s("Serahkan ke agen lain", "Hand off to another agent"), d: s("Saat kuota satu agen habis, sesi diserahkan ke agen lain beserta ringkasannya. Disarankan atau otomatis, Anda yang memilih.", "When one agent's quota runs out, the session moves to another with a summary. Suggested or automatic, your choice.") },
  { t: s("Tetap jalan saat tab ditutup", "Keeps going with the tab closed"), d: s("Agen terus bekerja di Mac. Buka lagi dari browser atau HP kapan saja.", "Agents keep working on the Mac. Open it again from a browser or your phone whenever you like.") },
  { t: "Git", d: s("Satu sesi bisa punya worktree sendiri: lihat file dan diff, batalkan satu file, commit, push, lalu merge kembali.", "A session can have its own worktree: see changed files and diffs, revert a file, commit, push and merge back.") },
  { t: s("Kuota dan konteks", "Quotas and context"), d: s("Persentase pemakaian tiap agen, batas 5 jam dan 7 hari Claude, serta seberapa penuh jendela konteks.", "Usage per agent, Claude's 5-hour and 7-day limits, and how full the context window is.") },
  { t: s("Terminal", "Terminal"), d: s("Terminal zsh sungguhan di browser yang tetap berjalan, dengan tombol Esc, Tab, Ctrl, dan panah untuk HP.", "A real zsh terminal in the browser that keeps running, with Esc, Tab, Ctrl and arrow keys for the phone.") },
];

const safe = [
  s("Server hanya mendengarkan 127.0.0.1, tidak terbuka ke internet.", "The server listens on 127.0.0.1 only, never the public internet."),
  s("Akses dari HP lewat Tailscale di dalam tailnet Anda sendiri, tetap dengan PIN.", "Phone access goes through Tailscale inside your own tailnet, still behind a PIN."),
  s("Memakai login agen yang sudah ada di Mac. Tidak ada akun DyskOS.", "It uses the agent logins already on your Mac. There is no DyskOS account."),
];
---

<Base
  title={s("DyskOS: dasbor lokal untuk agen AI coding | DyskLab", "DyskOS: a local dashboard for AI coding agents | DyskLab")}
  description={s(
    "DyskOS menjalankan Claude Code, Codex, Gemini CLI, OpenCode, dan Hermes berdampingan dari Mac atau HP. Setiap agen punya sesi sendiri, dan semuanya tetap di Mac Anda.",
    "DyskOS runs Claude Code, Codex, Gemini CLI, OpenCode and Hermes side by side from your Mac or your phone. Each agent gets its own session, and everything stays on your Mac.",
  )}
  path={Astro.url.pathname}
  ogImage="/images/products/dyskos/og.jpg"
  ogTitle="DyskOS"
  fonts="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  theme="dark"
  themeColor="#14110f"
>
  <div class="os" id="top">
    <ProductBar
      lang={lang}
      name="DyskOS"
      icon="/images/apps/dyskos.png"
      links={[
        { href: "#tampilan", label: s("Tampilan", "Views") },
        { href: "#fitur", label: s("Fitur", "Features") },
        { href: "#aman", label: s("Keamanan", "Safety") },
      ]}
      cta={{ href: "#tampilan", label: s("Lihat tampilan", "See the views") }}
    />

    <main>
      <header class="hero">
        <div class="wrap">
          <p class="pill"><span>{s("Baru", "New")}</span>macOS · Web · PWA</p>
          {lang === "id" ? (
            <h1>Semua agen AI Anda,<br /><span class="hl">satu dasbor.</span></h1>
          ) : (
            <h1>All your AI agents,<br /><span class="hl">one dashboard.</span></h1>
          )}
          <p class="lede">
            {s(
              "Jalankan Claude Code, Codex, Gemini CLI, OpenCode, dan Hermes berdampingan dari Mac atau HP. Lihat setiap langkahnya, setujui yang boleh dijalankan, dan serahkan pekerjaan ke agen lain saat kuota habis.",
              "Run Claude Code, Codex, Gemini CLI, OpenCode and Hermes side by side from your Mac or phone. Watch every step, approve what may run, and hand work to another agent when a quota runs out.",
            )}
          </p>
          <ul class="workers" aria-label={s("Agen yang didukung", "Supported agents")}>
            {workers.map((w) => <li>{w}</li>)}
          </ul>
          <p class="note">{s("DyskOS masih tahap awal dan sedang dikembangkan.", "DyskOS is in early development.")}</p>
          <div class="shot hero-shot dl-reveal">
            <span class="bar"><i></i><i></i><i></i></span>
            <img src={img("01-chat")} alt={shots[0].alt} width="1600" height="1000" decoding="async" />
          </div>
        </div>
      </header>

      <section id="tampilan" class="sec">
        <div class="wrap">
          <div class="head">
            <p class="kick">{s("Tampilan", "Views")}</p>
            <h2>{s("Lihat apa yang dikerjakan agen.", "See what your agents are doing.")}</h2>
          </div>
          <div class="grid">
            {shots.slice(1).map((x) => (
              <figure class="card dl-reveal">
                <div class="shot"><span class="bar"><i></i><i></i><i></i></span><img src={x.src} alt={x.alt} loading="lazy" decoding="async" /></div>
                <figcaption><b>{x.t}</b>{x.d}</figcaption>
              </figure>
            ))}
            <figure class="card phone dl-reveal">
              <img src={img("05-mobile")} alt={s("DyskOS dibuka dari HP", "DyskOS opened on a phone")} loading="lazy" decoding="async" />
              <figcaption><b>{s("Dari HP", "From your phone")}</b>{s("Pasang sebagai PWA dan pantau sesi dari mana saja di tailnet Anda.", "Install it as a PWA and follow your sessions from anywhere on your tailnet.")}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section id="fitur" class="sec sec-tight">
        <div class="wrap">
          <div class="head">
            <p class="kick">{s("Fitur", "Features")}</p>
            <h2>{s("Dibuat untuk kerja dengan banyak agen.", "Built for working with many agents.")}</h2>
          </div>
          <ul class="feat">
            {features.map((f) => <li class="dl-reveal"><h3>{f.t}</h3><p>{f.d}</p></li>)}
          </ul>
        </div>
      </section>

      <section id="aman" class="sec sec-tight">
        <div class="wrap">
          <div class="safe dl-reveal">
            <div>
              <p class="kick">{s("Keamanan", "Safety")}</p>
              <h2>{s("Semuanya tetap di Mac Anda.", "Everything stays on your Mac.")}</h2>
            </div>
            <ul>{safe.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>
    </main>

    <ProductFooter lang={lang} current="dyskos" />
  </div>
</Base>

<style>
  :global(body) { margin: 0; background: #14110f; }
  .os {
    --bg: #14110f; --card: #1d1814; --ink: #f6efe8; --muted: #a79d92; --line: #2e2721; --accent: #ea6a1f; --accent-s: #3a2314;
    --pb-bg: rgba(20, 17, 15, 0.85); --pb-fg: var(--ink); --pb-muted: var(--muted); --pb-line: var(--line); --pb-hover: var(--accent-s);
    --pb-btn-bg: var(--accent); --pb-btn-fg: #fff; --pb-radius: 999px; --pb-font: "Plus Jakarta Sans", sans-serif;
    --pf-line: var(--line); --pf-muted: var(--muted); --pf-fg: var(--ink); --pf-card: var(--card); --pf-hover: #5a3a22; --pf-radius: 22px; --pf-font: "Plus Jakarta Sans", sans-serif;
    background: var(--bg); color: var(--ink); font: 400 16px/1.6 "Plus Jakarta Sans", system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  .wrap { width: min(1140px, calc(100% - 32px)); margin: 0 auto; }
  h1, h2, h3 { margin: 0; letter-spacing: -0.035em; line-height: 1.05; }
  .hero { position: relative; padding: 72px 0 40px; }
  .hero::before { content: ""; position: absolute; left: 50%; top: -30%; width: 900px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(234, 106, 31, 0.28), transparent); pointer-events: none; }
  .hero .wrap { position: relative; text-align: center; }
  .pill { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 5px 14px 5px 5px; border-radius: 999px; background: var(--card); box-shadow: 0 0 0 1px var(--line); font-size: 13.5px; color: var(--muted); }
  .pill span { padding: 3px 10px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 700; font-size: 12.5px; }
  h1 { margin-top: 24px; font-size: clamp(40px, 6vw, 76px); font-weight: 800; }
  .hl { color: var(--accent); }
  .lede { margin: 22px auto 0; max-width: 640px; font-size: 18px; color: var(--muted); }
  .workers { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .workers li { padding: 7px 14px; border-radius: 999px; background: var(--card); box-shadow: 0 0 0 1px var(--line); font-size: 13.5px; font-weight: 600; }
  .note { margin: 18px 0 0; font-size: 13.5px; color: var(--muted); }
  .shot { border-radius: 16px; overflow: hidden; background: var(--card); box-shadow: 0 0 0 1px var(--line), 0 50px 100px -50px rgba(234, 106, 31, 0.35); }
  .hero-shot { margin-top: 44px; text-align: left; }
  .bar { display: flex; gap: 7px; padding: 11px 14px; background: #0f0c0a; }
  .bar i { width: 11px; height: 11px; border-radius: 50%; background: #3a332c; }
  .bar i:first-child { background: #ff6b5e; } .bar i:nth-child(2) { background: #ffc130; } .bar i:nth-child(3) { background: #2bd15a; }
  .shot img { display: block; width: 100%; height: auto; }
  .sec { padding: 100px 0; }
  .sec-tight { padding-top: 40px; }
  .head { max-width: 640px; }
  .kick { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  h2 { font-size: clamp(30px, 4vw, 48px); font-weight: 800; }
  .grid { margin-top: 40px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card { margin: 0; padding: 14px; border-radius: 24px; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
  .card figcaption { padding: 16px 6px 6px; color: var(--muted); font-size: 15px; }
  .card figcaption b { display: block; margin-bottom: 4px; color: var(--ink); font-size: 17px; }
  .phone { display: flex; flex-direction: column; align-items: center; }
  .phone img { width: auto; max-width: 100%; max-height: 420px; border-radius: 16px; }
  .phone figcaption { align-self: stretch; }
  .feat { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .feat li { padding: 24px; border-radius: 22px; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
  .feat h3 { font-size: 19px; letter-spacing: -0.02em; }
  .feat p { margin: 10px 0 0; color: var(--muted); font-size: 15px; }
  .safe { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 40px; border-radius: 28px; background: var(--accent-s); box-shadow: 0 0 0 1px #5a3a22; }
  .safe ul { margin: 0; padding-left: 20px; display: grid; gap: 12px; color: var(--ink); }
  @media (max-width: 860px) {
    .grid, .safe { grid-template-columns: 1fr; }
    .feat { grid-template-columns: 1fr; }
    .sec { padding: 64px 0; }
    .safe { padding: 28px; gap: 20px; }
  }
</style>
