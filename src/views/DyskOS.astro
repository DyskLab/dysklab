---
/*
  DyskOS product page. Deliberately has no download or repository link: DyskOS is shown, not
  distributed. Shared layout tinted orange (#ea6a1f). Bilingual through s(id, en). Static, no client script.
*/
import Base from "../layouts/Base.astro";
import ProductBar from "../components/ProductBar.astro";
import ProductFooter from "../components/ProductFooter.astro";
import { pick, ui, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = <T,>(id: T, en: T): T => pick(lang, { id, en });
const img = (n: string) => `/images/products/dyskos/${n}.jpg`;

const workers = ["Claude Code", "Codex", "OpenCode", "Hermes"];

const shots = [
  { src: img("01-chat"), t: s("Chat", "Chat"), d: s("Balasan streaming, setiap langkah agen, subagent paralel, dan kartu izin sebelum perintah dijalankan.", "Streamed replies, every step the agent takes, parallel subagents, and permission cards before anything runs."), alt: s("Sesi Claude dengan tiga subagent di DyskOS", "A Claude session with three subagents in DyskOS") },
  { src: img("02-town"), t: "Town", d: s("Kota pixel-art: tiap sesi adalah karakter, dan tiap agen punya kantor di jalan utama. Yang bekerja mengetik di mejanya, yang butuh izin berdiri dengan tanda seru, dan yang menganggur jalan-jalan ke kantin, taman, atau pasar.", "A pixel-art town where each session is a character and each agent has an office on the main road. Working ones type at their desks, one that needs permission stands up with a “!”, and idle ones wander to the canteen, park or market."), alt: s("Tampilan Town di DyskOS", "The Town view in DyskOS") },
  { src: img("03-agents"), t: s("Agen", "Agents"), d: s("Empat agen dan kuota masing-masing, lengkap dengan login dan model yang tersedia.", "Four agents with their quotas, logins and available models."), alt: s("Daftar agen dan kuota di DyskOS", "The agents and quotas in DyskOS") },
  { src: img("04-inbox"), t: "Inbox", d: s("Permintaan izin, error, dan balasan belum dibaca dari semua sesi di satu tempat.", "Permission requests, errors and unread replies from every session in one place."), alt: s("Inbox di DyskOS", "The Inbox in DyskOS") },
  { src: img("06-skills"), t: "Skills", d: s("Katalog skill dengan paket cepat, dipasang ke proyek atau global lewat Term.", "A skill catalog with quick packs, installed per project or globally through Term."), alt: s("Katalog Skills di DyskOS", "The Skills catalog in DyskOS") },
];

const features = [
  { t: s("Empat agen, satu tempat", "Four agents, one place"), d: s("Claude Code, Codex, OpenCode, dan Hermes jalan berdampingan, masing-masing dengan sesinya sendiri. Agen mana pun bisa dimatikan di Pengaturan.", "Claude Code, Codex, OpenCode and Hermes run side by side, each with its own session. Any agent can be switched off in Settings.") },
  { t: s("9router untuk model lain", "9router for other models"), d: s("Gemini, DeepSeek, dan penyedia lain muncul di OpenCode dan Hermes lewat 9router. Model yang ditolak penyedia disembunyikan, dan mode Otomatis memilih yang masih berfungsi.", "Gemini, DeepSeek and other providers show up in OpenCode and Hermes through 9router. Models a provider rejects are hidden, and Auto picks one that works.") },
  { t: s("Hemat token", "Token saver"), d: s("Ringkas keluaran tool dengan RTK, jawaban lebih pendek (Caveman), dan kode minimal (Ponytail) di tingkat Lite, Full, atau Ultra.", "Compress tool output with RTK, shorter answers (Caveman) and minimal code (Ponytail) at Lite, Full or Ultra.") },
  { t: "Skills", d: s("Katalog skill agen dengan paket cepat. Pilih skill dan proyek, lalu DyskOS memasangnya untuk Claude Code, OpenCode, Codex, dan Hermes.", "A catalog of agent skills with quick packs. Pick skills and a project, and DyskOS installs them for Claude Code, OpenCode, Codex and Hermes.") },
  { t: s("Serahkan ke agen lain", "Hand off to another agent"), d: s("Saat kuota satu agen habis, sesi diserahkan ke agen lain beserta ringkasannya. Disarankan atau otomatis, Anda yang memilih.", "When one agent's quota runs out, the session moves to another with a summary. Suggested or automatic, your choice.") },
  { t: s("Tetap jalan saat tab ditutup", "Keeps going with the tab closed"), d: s("Agen terus bekerja di Mac. Buka lagi dari browser atau HP kapan saja.", "Agents keep working on the Mac. Open it again from a browser or your phone whenever you like.") },
  { t: "Git", d: s("Satu sesi bisa punya worktree sendiri: lihat file dan diff, batalkan satu file, commit, push, lalu merge kembali.", "A session can have its own worktree: see changed files and diffs, revert a file, commit, push and merge back.") },
  { t: s("Kuota dan konteks", "Quotas and context"), d: s("Persentase pemakaian tiap agen, batas 5 jam dan 7 hari Claude, serta seberapa penuh jendela konteks.", "Usage per agent, Claude's 5-hour and 7-day limits, and how full the context window is.") },
  { t: s("Terminal", "Terminal"), d: s("Terminal zsh sungguhan di browser yang tetap berjalan, dengan tombol Esc, Tab, Ctrl, dan panah untuk HP.", "A real zsh terminal in the browser that keeps running, with Esc, Tab, Ctrl and arrow keys for the phone.") },
];

const safe = [
  s("Server hanya mendengarkan 127.0.0.1, tidak terbuka ke internet.", "The server listens on 127.0.0.1 only, never the public internet."),
  s("Akses dari HP lewat Tailscale di dalam tailnet Anda sendiri, tetap dengan PIN.", "Phone access goes through Tailscale inside your own tailnet, still behind a PIN."),
  s("Memakai login agen yang sudah ada di Mac. Tidak ada akun DyskOS.", "It uses the agent logins already on your Mac. There is no DyskOS account."),
];
---

<Base
  title={s("DyskOS: dasbor lokal untuk agen AI coding | DyskLab", "DyskOS: a local dashboard for AI coding agents | DyskLab")}
  description={s(
    "DyskOS menjalankan Claude Code, Codex, OpenCode, dan Hermes berdampingan dari Mac atau HP. Setiap agen punya sesi sendiri, dan semuanya tetap di Mac Anda.",
    "DyskOS runs Claude Code, Codex, OpenCode and Hermes side by side from your Mac or your phone. Each agent gets its own session, and everything stays on your Mac.",
  )}
  path={Astro.url.pathname}
  ogImage="/images/products/dyskos/og.jpg"
  ogTitle="DyskOS"
  accent="#ea6a1f"
>
  <div id="top">
    <ProductBar
      lang={lang}
      name="DyskOS"
      icon="/images/apps/dyskos.png"
      links={[
        { href: "#tampilan", label: s("Tampilan", "Views") },
        { href: "#fitur", label: s("Fitur", "Features") },
        { href: "#aman", label: s("Keamanan", "Safety") },
      ]}
      cta={{ href: "#tampilan", label: s("Lihat tampilan", "See the views") }}
    />

    <main>
      <header class="hero dl-gridbg">
        <div class="dl-wrap dl-head-c">
          <p class="dl-eyebrow"><b>{s("Baru", "New")}</b>macOS · Web · PWA</p>
          {lang === "id" ? (
            <h1 class="dl-h1">Semua agen AI Anda,<br /><span class="dl-hl">satu dasbor.</span></h1>
          ) : (
            <h1 class="dl-h1">All your AI agents,<br /><span class="dl-hl">one dashboard.</span></h1>
          )}
          <p class="dl-lede">
            {s(
              "Jalankan Claude Code, Codex, OpenCode, dan Hermes berdampingan dari Mac atau HP. Lihat setiap langkahnya, setujui yang boleh dijalankan, dan serahkan pekerjaan ke agen lain saat kuota habis.",
              "Run Claude Code, Codex, OpenCode and Hermes side by side from your Mac or phone. Watch every step, approve what may run, and hand work to another agent when a quota runs out.",
            )}
          </p>
          <div class="dl-actions">
            <a class="dl-btn dl-btn-primary" href="#tampilan">{s("Lihat tampilan", "See the views")}<span class="dl-arr" aria-hidden="true">→</span></a>
            <a class="dl-btn dl-btn-ghost" href="#fitur">{s("Fitur", "Features")}<span class="dl-arr" aria-hidden="true">↓</span></a>
          </div>
          <ul class="dl-checks" aria-label={s("Agen yang didukung", "Supported agents")}>
            {workers.map((w) => <li>{w}</li>)}
          </ul>
          <p class="note">{s("DyskOS masih tahap awal dan sedang dikembangkan.", "DyskOS is in early development.")}</p>
        </div>
        <div class="dl-wrap">
          <div class="dl-shot hero-shot dl-reveal">
            <span class="dl-bar"><i></i><i></i><i></i></span>
            <img src={img("01-chat")} alt={shots[0].alt} width="1600" height="1000" decoding="async" />
          </div>
        </div>
      </header>

      <section id="tampilan" class="dl-sec">
        <div class="dl-wrap">
          <div class="dl-head">
            <p class="dl-label">{s("Tampilan", "Views")}</p>
            <h2 class="dl-h2">{s("Lihat apa yang ", "See what your ")}<span class="dl-hl">{s("dikerjakan agen.", "agents are doing.")}</span></h2>
          </div>
          <div class="grid">
            {shots.slice(1).map((x) => (
              <figure class="card dl-card dl-card-hover dl-reveal">
                <div class="dl-shot"><span class="dl-bar"><i></i><i></i><i></i></span><img src={x.src} alt={x.alt} loading="lazy" decoding="async" /></div>
                <figcaption><b>{x.t}</b>{x.d}</figcaption>
              </figure>
            ))}
            <figure class="card dl-card dl-card-hover phone dl-reveal">
              <img src={img("05-mobile")} alt={s("DyskOS dibuka dari HP", "DyskOS opened on a phone")} loading="lazy" decoding="async" />
              <figcaption><b>{s("Dari HP", "From your phone")}</b>{s("Pasang sebagai PWA dan pantau sesi dari mana saja di tailnet Anda.", "Install it as a PWA and follow your sessions from anywhere on your tailnet.")}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section id="fitur" class="dl-sec dl-alt">
        <div class="dl-wrap">
          <div class="dl-head dl-head-c">
            <p class="dl-eyebrow">{s("Fitur", "Features")}</p>
            <h2 class="dl-h2">{s("Dibuat untuk kerja dengan ", "Built for working with ")}<span class="dl-hl">{s("banyak agen.", "many agents.")}</span></h2>
          </div>
          <ul class="dl-feats">
            {features.map((f) => <li class="dl-reveal"><h3>{f.t}</h3><p>{f.d}</p></li>)}
          </ul>
        </div>
      </section>

      <section id="aman" class="dl-sec">
        <div class="dl-wrap">
          <div class="safe dl-featured dl-reveal">
            <div>
              <p class="safe-k">{s("Keamanan", "Safety")}</p>
              <h2>{s("Semuanya tetap di Mac Anda.", "Everything stays on your Mac.")}</h2>
            </div>
            <ul class="dl-list">{safe.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>
    </main>

    <ProductFooter lang={lang} current="dyskos" />
  </div>
</Base>

<style>
  .hero { padding: 64px 0 24px; }
  .note { margin: 16px 0 0; font-size: 13.5px; color: var(--muted); }
  .hero-shot { margin-top: 56px; }
  .grid { margin-top: 44px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card { margin: 0; padding: 14px; }
  .card .dl-shot { box-shadow: none; }
  .card figcaption { padding: 16px 6px 6px; font-size: 15px; }
  .card figcaption b { display: block; margin-bottom: 4px; color: var(--ink); font-size: 17px; }
  .phone { display: flex; flex-direction: column; align-items: center; }
  .phone img { width: auto; max-width: 100%; max-height: 420px; border-radius: 16px; }
  .phone figcaption { align-self: stretch; }
  .safe { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 48px; border-radius: 24px; }
  .safe-k { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }
  .safe h2 { font-size: clamp(28px, 3.6vw, 42px); font-weight: 800; }
  @media (max-width: 860px) {
    .grid, .safe { grid-template-columns: 1fr; }
    .safe { padding: 28px; gap: 20px; }
  }
</style>
