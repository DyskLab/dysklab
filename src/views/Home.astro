                  <img src={p.icon} width="40" height="40" alt="" loading="lazy" />
                  <span class="pr-name"><b>{p.name}</b><small>{p.kindL}</small></span>
                  <span class="pr-plus" aria-hidden="true"></span>
                </button>
                <article class="pr-panel" id={`pr-p-${p.slug}`} aria-labelledby={`pr-t-${p.slug}`} data-open={i === 0 ? "" : undefined}>
