    --pf-line: var(--line); --pf-muted: var(--muted); --pf-fg: var(--fg); --pf-card: var(--card); --pf-radius: 16px;
    --pb-btn-bg: var(--blue); --pb-btn-fg: #fff; --pb-radius: 12px;
