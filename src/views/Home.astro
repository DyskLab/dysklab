                  <p>{d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- support -->
      <section id="dukung" class="dl-sec">
        <div class="dl-wrap">
          <div class="support dl-reveal">
            <div class="support-copy dl-featured">
              <p class="support-k">{T.supK}</p>
              <h2>{T.supH}</h2>
              <p>{T.supP}</p>
              <a class="dl-btn dl-btn-coffee" href={BMC} target="_blank" rel="noopener"><span aria-hidden="true">☕</span>{t.coffee}<span class="dl-arr" aria-hidden="true">→</span><span class="dl-sr">{t.newTab}</span></a>
            </div>
            <div class="support-stars dl-card">
              <p class="dl-label">{T.starEach}</p>
              <ul class="star-list">
                {products.filter((p) => p.repo).map((p) => (
                  <li><a href={`https://github.com/${p.repo}`} target="_blank" rel="noopener" style={`--c:${p.color}`}>
                    <img src={p.icon} width="24" height="24" alt="" />{p.name}<span class="s">★</span><span class="dl-sr">{t.newTab}</span>
                  </a></li>
                ))}
                <li><a href="https://github.com/DyskLab/dysklink-desktop" target="_blank" rel="noopener" style="--c:#2dd4a7">
                  <img src="/images/apps/dysklink.png" width="24" height="24" alt="" />DyskLink Windows/Linux<span class="s">★</span><span class="dl-sr">{t.newTab}</span>
                </a></li>
                <li><a href="https://github.com/DyskLab/dysklink-android" target="_blank" rel="noopener" style="--c:#2dd4a7">
                  <img src="/images/apps/dysklink.png" width="24" height="24" alt="" />DyskLink Android<span class="s">★</span><span class="dl-sr">{t.newTab}</span>
                </a></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- client work (secondary) -->
      <section id="layanan" class="dl-sec dl-alt dl-gridbg">
        <div class="dl-wrap">
          <div class="dl-head-row dl-reveal">
            <div class="dl-head">
              <span class="svc-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m8 8-5 4 5 4M16 8l5 4-5 4M14 5l-4 14" /></svg></span>
              <p class="dl-label">{T.svcK}</p>
              <h2 class="dl-h2">{T.svcH}</h2>
              <p class="dl-sub">{T.svcP}</p>
            </div>
          </div>
          <div class="svc">
            {groups.map((g, gi) => (
              <div class:list={["svc-g", "dl-card", "dl-reveal", { "dl-featured": gi === 0 }]}>
                <span class="svc-ic" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={gi === 0 ? '<path d="M4 20h16M6 16l4-10 4 6 2-3 3 7"/>' : '<path d="M12 3 4 6v6c0 4.4 3.4 8.3 8 9 4.6-.7 8-4.6 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>'} /></span>
                <h3>{g.title}</h3>
                <ul>{g.items.map(([n, d]) => <li><b>{n}</b><span>{d}</span></li>)}</ul>
              </div>
            ))}
          </div>

          <div class="dl-head-row sub-row dl-reveal">
            <h3 class="sub">{T.casesH}</h3>
          </div>
          <ul class="cases">
            {cases.map((c) => (
              <li class="case dl-card dl-card-hover dl-reveal">
                {c.image && <img src={c.image} width="1200" height="750" alt="" loading="lazy" decoding="async" />}
                <div class="case-b">
                  <p class="case-k"><span>{c.client}</span>{c.sectorL}</p>
                  <h4>{c.titleL}</h4>
                  <p class="case-s">{c.stack.join(" · ")}</p>
                  {c.demo && <a href={c.demo} target="_blank" rel="noopener">{T.visit} {c.host} →<span class="dl-sr">{t.newTab}</span></a>}
                </div>
              </li>
            ))}
          </ul>

          <h3 class="sub dl-reveal">{T.quotesH}</h3>
          <ul class="quotes">
            {testimonials.map((q, i) => (
              <li class:list={["dl-card", "dl-reveal", { "dl-featured": i === 1 }]}>
                <svg class="q-mark" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z" /></svg>
                <blockquote>{q.quoteL}</blockquote>
                <p><b>{mask(q.name)}</b>{q.roleL}</p>
              </li>
            ))}
          </ul>
          {T.quoteNote && <p class="note">{T.quoteNote}</p>}

          <div class="contact dl-featured dl-reveal" id="mulai">
            <h3>{T.contactH}</h3>
            <p>{T.contactP}</p>
            <div class="dl-actions dl-actions-c">
              <a class="dl-btn dl-btn-light" href={waHello} target="_blank" rel="noopener">WhatsApp<span class="dl-arr wa" aria-hidden="true"><Icon name="whatsapp" size={19} /></span><span class="dl-sr">{t.newTab}</span></a>
              <a class="dl-btn dl-btn-outline-light dl-btn-plain mail" href={mail}><Icon name="mail" size={18} />{content.email}</a>
            </div>
          </div>
        </div>
      </section>

      <Faq lang={lang} items={T.faq} help={{ href: waHello, label: lang === "id" ? "Tanya lewat WhatsApp" : "Ask on WhatsApp", external: true }} />
    </main>

    <SiteFooter lang={lang} />
  </div>
  <script>
    // Product showcase: one product open at a time (list + stage on desktop, accordion on phones).
    document.querySelectorAll<HTMLElement>("[data-pr]").forEach((box) => {
      const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>(".pr-tab"));
      const open = (tab: HTMLButtonElement, focusPanel = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-expanded", String(on));
          const panel = document.getElementById(t.getAttribute("aria-controls")!);
          if (panel) on ? panel.setAttribute("data-open", "") : panel.removeAttribute("data-open");
        });
        if (focusPanel && matchMedia("(max-width: 900px)").matches) tab.scrollIntoView({ block: "nearest", behavior: "smooth" });
      };
      tabs.forEach((t) => t.addEventListener("click", () => open(t, true)));
      box.classList.add("is-js");
    });
  </script>
</Base>

<style>
  /* hero */
  .hero { padding: 88px 0 56px; overflow: hidden; }
  .hero-copy { position: relative; max-width: 860px; }
  .hero .dl-h1 { font-size: clamp(40px, 6.6vw, 76px); }
  .float { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; }
  .float li { position: absolute; padding: 10px; border-radius: 22px; background: color-mix(in srgb, var(--card) 80%, transparent); border: 1px solid var(--line); box-shadow: 0 30px 50px -24px color-mix(in srgb, var(--c) 70%, transparent); animation: bob 7s ease-in-out infinite; }
  .float img { display: block; border-radius: 15px; }
  .float .f0 { left: 6%; top: 16%; transform: rotate(-10deg); }
  .float .f1 { left: 13%; top: 48%; transform: rotate(6deg); animation-delay: -1s; }
  .float .f2 { left: 4%; top: 74%; transform: rotate(-4deg); animation-delay: -2s; }
  .float .f3 { left: 18%; top: 82%; transform: rotate(9deg); scale: 0.75; animation-delay: -3s; }
  .float .f4 { right: 6%; top: 14%; transform: rotate(10deg); animation-delay: -4s; }
  .float .f5 { right: 14%; top: 44%; transform: rotate(-7deg); animation-delay: -5s; }
  .float .f6 { right: 4%; top: 68%; transform: rotate(5deg); animation-delay: -6s; }
  .float .f7 { right: 18%; top: 82%; transform: rotate(-9deg); scale: 0.75; animation-delay: -2.5s; }
  .float .f8 { left: 22%; top: 8%; transform: rotate(4deg); scale: 0.7; animation-delay: -4.5s; }
  @keyframes bob { 50% { translate: 0 -10px; } }
  @media (prefers-reduced-motion: reduce) { .float li { animation: none; } }
  .scroll { position: relative; display: grid; place-items: center; width: 30px; height: 46px; margin: 48px auto 0; border-radius: 999px; border: 1.5px solid var(--line-2); color: var(--muted); text-decoration: none; font-size: 14px; }
  .scroll span { animation: bob 2.4s ease-in-out infinite; }

  /* product strip: an endless marquee (two identical lists sliding by half the track) */
  .strip { overflow: hidden; border-block: 1px solid var(--line); background: var(--bg-2); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .strip-track { display: flex; width: max-content; animation: strip 40s linear infinite; }
  .strip:hover .strip-track, .strip:focus-within .strip-track { animation-play-state: paused; }
  .strip ul { list-style: none; margin: 0; padding: 18px 0; display: flex; gap: 12px; padding-right: 12px; }
  .strip li { flex: none; }
  .strip a { display: flex; align-items: center; gap: 12px; padding: 8px 18px 8px 8px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); text-decoration: none; white-space: nowrap; transition: border-color 0.2s, transform 0.2s; }
  .strip a:hover { border-color: color-mix(in srgb, var(--c) 55%, transparent); transform: translateY(-2px); }
  .strip img { border-radius: 9px; }
  .strip b { display: block; color: var(--ink); font-size: 15px; line-height: 1.2; }
  .strip small { display: block; font-size: 12.5px; color: var(--muted); }
  @keyframes strip { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .strip-track { animation: none; width: auto; justify-content: center; flex-wrap: wrap; }
    .strip ul[aria-hidden] { display: none; }
    .strip ul { flex-wrap: wrap; justify-content: center; padding-inline: 16px; }
  }

  /* product showcase */
  .pr {
    position: relative; margin-top: 56px; display: grid; grid-template-columns: 340px 1fr; grid-auto-rows: min-content; column-gap: 28px; row-gap: 6px;
    padding: 18px; border-radius: 28px; border: 1px solid var(--line); background:
      radial-gradient(60% 50% at 85% 10%, color-mix(in srgb, var(--brand) 14%, transparent), transparent 70%),
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 48px 48px, var(--card);
  }
  .pr-item { display: contents; }
  .pr-tab {
    grid-column: 1; display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 14px; border-radius: 16px; border: 1px solid transparent;
    background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; transition: background 0.2s, border-color 0.2s;
  }
  .pr-tab:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .pr-tab[aria-expanded="true"] { background: var(--bg); border-color: var(--accent-line); box-shadow: 0 16px 30px -20px var(--accent); }
  .pr-n { width: 22px; flex: none; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; color: var(--muted); }
  .pr-tab[aria-expanded="true"] .pr-n { color: var(--accent-hi); }
  .pr-tab img { border-radius: 10px; flex: none; }
  .pr-name { display: grid; line-height: 1.25; flex: 1; }
  .pr-name b { color: var(--ink); font-size: 16px; }
  .pr-name small { color: var(--muted); font-size: 13px; }
  .pr-plus { position: relative; width: 26px; height: 26px; flex: none; border-radius: 50%; background: var(--accent-soft); opacity: 0; transition: opacity 0.2s; }
  .pr-plus::before { content: "→"; position: absolute; inset: 0; display: grid; place-items: center; font-size: 13px; color: var(--accent-hi); }
  .pr-tab[aria-expanded="true"] .pr-plus { opacity: 1; }
  .pr-panel { grid-column: 2; grid-row: 1 / span 9; display: grid; grid-template-rows: auto 1fr; gap: 24px; padding: 18px 10px 10px; }
  .is-js .pr-panel:not([data-open]) { display: none; }
  .pr-panel[data-open] { animation: fade 0.35s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
  .pr-copy { display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; align-content: start; }
  .pr-tag { grid-column: 1 / -1; margin: 0; color: var(--ink); font-size: clamp(22px, 2.4vw, 30px); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; }
