  .nav-links a:hover { color: var(--fg); background: var(--bg-2); }
  .nav-act { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 6px; height: 38px; min-width: 38px; justify-content: center; padding: 0 10px; box-sizing: border-box; border-radius: 10px; border: 1px solid var(--line); background: var(--card); color: var(--fg); font: 600 13px Geist, sans-serif; text-decoration: none; cursor: pointer; }
  .chip:hover { border-color: var(--muted); }
  .chip svg { width: 16px; height: 16px; fill: currentColor; }
  .theme svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
