                          ★ {t.star}{p.star !== null && p.star >= 10 && ` · ${p.star}`}<span class="dl-sr">{t.newTab}</span>
                        </a>
                      )}
                    </div>
                  </div>
                  <a class="pr-shot" href={p.url} tabindex="-1" aria-hidden="true">
                    <span class="dl-shot">
                      <span class="dl-bar"><i></i><i></i><i></i></span>
