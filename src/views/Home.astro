  /* hero */
  .hero { position: relative; padding: 72px 0 40px; }
  .hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(50% 60% at 80% 20%, rgba(77, 124, 255, 0.14), transparent 70%), linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 44px; mask: linear-gradient(#000, transparent 85%); opacity: 0.6; pointer-events: none; }
