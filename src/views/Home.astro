  h1, h2, h3, h4 { margin: 0; letter-spacing: -0.035em; line-height: 1.05; }
  a { color: inherit; }
  .muted { color: var(--muted); }
  .blue { color: var(--blue); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 48px; padding: 0 20px; border-radius: 12px; font-weight: 600; font-size: 15px; text-decoration: none; transition: transform 0.15s, background 0.2s, box-shadow 0.2s; white-space: nowrap; }
  .btn:hover { transform: translateY(-1px); }
  .btn-ink { background: var(--fg); color: var(--bg); height: 38px; padding: 0 14px; font-size: 14px; }
  .btn-blue { background: var(--blue); color: #fff; box-shadow: 0 10px 24px -12px rgba(77, 124, 255, 0.8); }
  .btn-line { border: 1px solid var(--line); background: var(--card); color: var(--fg); }
  .btn-line:hover { border-color: var(--muted); }
  .btn-c { background: var(--c); color: #fff; }
