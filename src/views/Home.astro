            <h2 class="dl-h2">{T.whyH}</h2>
          </div>
          <ol class="why">
            {T.why.map(([h, d], i) => (
              <li class="dl-reveal">
                <span class="why-node" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={whyIcons[i]} /><b>{i + 1}</b></span>
