  .strip { list-style: none; margin: 56px 0 0; padding: 18px 0 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; border-top: 1px solid var(--line); font: 500 13.5px "Geist Mono", monospace; color: var(--muted); }

