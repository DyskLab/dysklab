  .pr-art { display: grid; place-items: center; aspect-ratio: 16 / 9; background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--accent) 45%, var(--card)), var(--card) 70%); }
  .pr-shot .pr-art img { width: 112px; height: 112px; aspect-ratio: 1; border-radius: 28px; box-shadow: 0 30px 60px -20px var(--accent); }

  /* why: numbered steps joined by a dashed line */
  .why { list-style: none; margin: 64px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; position: relative; }
  .why::before { content: ""; position: absolute; left: 12.5%; right: 12.5%; top: 31px; border-top: 1.5px dashed var(--line-2); }
