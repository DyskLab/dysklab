---
/*
  Top bar for a product page: SiteNav with the product next to the DyskLab brand, the
  section links, the product's GitHub repo (star count from 10 up) and its primary action.
  A closed product (no `repo`) links to the DyskLab GitHub organisation instead.
*/
import SiteNav from "./SiteNav.astro";
import { stars } from "../lib/github";
import type { Lang } from "../i18n";
interface Props {
  lang: Lang;
  name: string;
  icon: string;
  repo?: string; // "DyskLab/dyskfiles"; omit for a closed product
  links: { href: string; label: string }[];
  cta: { href: string; label: string; external?: boolean };
}
const { lang, name, icon, repo, links, cta } = Astro.props;
const count = repo ? await stars(repo) : null;
---
<SiteNav lang={lang} links={links} cta={cta} product={{ name, icon }} github={`https://github.com/${repo ?? "DyskLab"}`} stars={count} />
