---
/* End of a product page: the other DyskLab products as cards, then the shared SiteFooter. */
import content from "../data/content";
import SiteFooter from "./SiteFooter.astro";
import { href, ui, type Lang } from "../i18n";
interface Props { lang: Lang; current: string; license?: string }
const { lang, current, license = "MIT License" } = Astro.props;
const t = ui[lang];
const others = content.apps.filter((a) => a.slug !== current);
---
<section class="pf dl-sec" aria-labelledby="pf-title">
  <div class="dl-wrap">
    <div class="dl-head-row">
      <div>
        <p class="dl-label">DyskLab</p>
        <h2 class="dl-h2" id="pf-title">{t.otherProducts}</h2>
      </div>
      <a class="pf-all" href={`${href(lang, "/")}#produk`}>{lang === "id" ? "Semua produk" : "All products"} →</a>
    </div>
    <ul class="pf-grid">
      {others.map((a) => (
        <li>
          <a class="dl-card" href={href(lang, a.page)}>
            <img src={a.icon} width="44" height="44" alt="" loading="lazy" />
            <span><b>{a.name}</b><small>{lang === "id" ? a.kind : a.kind_en} · {a.platform}</small></span>
            <i aria-hidden="true">→</i>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<SiteFooter lang={lang} license={license} />

<style>
  .pf { padding-bottom: 72px; }
  .pf-all { font-size: 14.5px; font-weight: 600; color: var(--accent-hi); text-decoration: none; }
  .pf-grid { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .pf-grid a { position: relative; display: flex; align-items: center; gap: 12px; padding: 16px; text-decoration: none; height: 100%; box-sizing: border-box; }
  .pf-grid img { border-radius: 11px; flex: none; }
  .pf-grid b { display: block; color: var(--ink); font-size: 15.5px; }
  .pf-grid small { display: block; font-size: 12.5px; color: var(--muted); line-height: 1.4; }
  .pf-grid i { margin-left: auto; font-style: normal; color: var(--muted); transition: transform 0.2s, color 0.2s; }
  .pf-grid a:hover i { transform: translateX(3px); color: var(--accent-hi); }
  @media (max-width: 1000px) { .pf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pf-grid { grid-template-columns: 1fr; } }
</style>
