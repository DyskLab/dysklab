---
/*
  Shared product page for the smaller DyskLab products (DyskAdmin, DyskMedia, DyskStream,
  DyskPOS). Same shape as DyskOS, in the shared JasaWeb-style layout tinted with the
  product's accent: centred grid-lined hero, optional
  screenshots, features, a highlighted panel, and for open products a "get it" block plus
  ReportBug and Support. A product with no `repo` is shown, not distributed: no star,
  download or issue links. Views pass copy already picked for the current language.
*/
import Base from "../layouts/Base.astro";
import ProductBar from "./ProductBar.astro";
import ProductFooter from "./ProductFooter.astro";
import ReportBug from "./ReportBug.astro";
import Support from "./Support.astro";
import { ui, type Lang } from "../i18n";

interface Shot { src: string; t: string; d: string; alt: string }
interface Props {
  lang: Lang;
  slug: string;
  name: string;
  repo?: string;
  accent: string;
  title: string;
  description: string;
  ogImage?: string;
  pill: string;
  pillTag: string;
  h1: [string, string];
  lede: string;
  chips: string[];
  note?: string;
  hero?: Shot;
  shots?: Shot[];
  views?: { kick: string; h: string };
  features: { t: string; d: string }[];
  featH: string;
  panel: { kick: string; h: string; items: string[] };
  get?: { h: string; p: string; code: string };
  platforms: string[];
  license?: string;
  credit?: string;
}
const p = Astro.props;
const lang = p.lang;
const s = (id: string, en: string) => (lang === "id" ? id : en);
const nt = ui[lang].newTab;
const links = [
  ...(p.shots?.length ? [{ href: "#tampilan", label: s("Tampilan", "Views") }] : []),
  { href: "#fitur", label: s("Fitur", "Features") },
  { href: "#sorotan", label: p.panel.kick },
  ...(p.repo ? [{ href: "#pakai", label: s("Pasang", "Get it") }] : []),
];
const cta = p.repo
  ? { href: "#pakai", label: s("Pasang", "Get it") }
  : { href: "#fitur", label: s("Lihat fitur", "See features") };
---

<Base
  title={p.title}
  description={p.description}
  path={Astro.url.pathname}
  ogImage={p.ogImage ?? p.hero?.src ?? "/og.jpg"}
  ogTitle={p.name}
  accent={p.accent}
>
  <div id="top">
    <ProductBar lang={lang} name={p.name} icon={`/images/apps/${p.slug}.png`} repo={p.repo} links={links} cta={cta} />

    <main>
      <header class="hero dl-gridbg">
        <div class="dl-wrap dl-head-c">
          <p class="dl-eyebrow"><b>{p.pillTag}</b>{p.pill}</p>
          <h1 class="dl-h1">{p.h1[0]}<br /><span class="dl-hl">{p.h1[1]}</span></h1>
          <p class="dl-lede">{p.lede}</p>
          <div class="dl-actions">
            <a class="dl-btn dl-btn-primary" href={cta.href}>{cta.label}<span class="dl-arr" aria-hidden="true">→</span></a>
            {p.repo && <a class="dl-btn dl-btn-ghost" href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">GitHub<span class="dl-arr" aria-hidden="true">↗</span><span class="dl-sr">{nt}</span></a>}
          </div>
          <ul class="dl-checks">{p.chips.map((c) => <li>{c}</li>)}</ul>
          {p.note && <p class="note">{p.note}</p>}
        </div>
        <div class="dl-wrap">
          {p.hero ? (
            <div class="dl-shot hero-shot dl-reveal">
              <span class="dl-bar"><i></i><i></i><i></i></span>
              <img src={p.hero.src} alt={p.hero.alt} width="1600" height="1000" decoding="async" />
            </div>
          ) : (
            <div class="hero-art dl-reveal">
              <img src={`/images/apps/${p.slug}.png`} width="160" height="160" alt="" />
            </div>
          )}
        </div>
      </header>

      {p.shots && p.shots.length > 0 && (
        <section id="tampilan" class="dl-sec">
          <div class="dl-wrap">
            <div class="dl-head">
              <p class="dl-label">{p.views?.kick ?? s("Tampilan", "Views")}</p>
              <h2 class="dl-h2">{p.views?.h}</h2>
            </div>
            <div class="grid">
              {p.shots.map((x) => (
                <figure class="card dl-card dl-card-hover dl-reveal">
                  <div class="dl-shot"><span class="dl-bar"><i></i><i></i><i></i></span><img src={x.src} alt={x.alt} loading="lazy" decoding="async" /></div>
                  <figcaption><b>{x.t}</b>{x.d}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      <section id="fitur" class={`dl-sec${p.shots?.length ? " dl-alt" : ""}`}>
        <div class="dl-wrap">
          <div class="dl-head dl-head-c">
            <p class="dl-eyebrow">{s("Fitur", "Features")}</p>
            <h2 class="dl-h2">{p.featH}</h2>
          </div>
          <ul class="dl-feats">
            {p.features.map((f) => <li class="dl-reveal"><h3>{f.t}</h3><p>{f.d}</p></li>)}
          </ul>
        </div>
      </section>

      <section id="sorotan" class="dl-sec">
        <div class="dl-wrap">
          <div class="safe dl-featured dl-reveal">
            <div>
              <p class="safe-k">{p.panel.kick}</p>
              <h2>{p.panel.h}</h2>
            </div>
            <ul class="dl-list">{p.panel.items.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>

      {p.repo && p.get && (
        <section id="pakai" class="dl-sec dl-sec-tight">
          <div class="dl-wrap">
            <div class="get dl-card dl-reveal">
              <div>
                <p class="dl-label">{s("Pasang", "Get it")}</p>
                <h2>{p.get.h}</h2>
                <p class="get-p">{p.get.p}</p>
                <a class="dl-btn dl-btn-primary" href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">{s("Buka di GitHub", "Open on GitHub")}<span class="dl-arr" aria-hidden="true">↗</span><span class="dl-sr">{nt}</span></a>
              </div>
              <pre class="dl-pre"><code>{p.get.code}</code></pre>
            </div>
            {p.credit && <p class="credit" set:html={p.credit} />}
          </div>
        </section>
      )}

      {p.repo && <ReportBug lang={lang} product={p.name} repo={p.repo} platforms={p.platforms} />}
      {p.repo && <Support lang={lang} product={p.name} repos={[{ repo: p.repo }]} />}
    </main>

    <ProductFooter lang={lang} current={p.slug} license={p.license} />
  </div>
</Base>

<style>
  .hero { padding: 64px 0 24px; }
  .note { margin: 16px 0 0; font-size: 13.5px; color: var(--muted); }
  .hero-shot { margin-top: 56px; }
  .hero-art { margin: 56px auto 0; width: min(560px, 100%); aspect-ratio: 16 / 9; display: grid; place-items: center; border-radius: 24px; border: 1px solid var(--line); background: radial-gradient(circle at 50% 45%, var(--accent-line), var(--card) 70%); }
  .hero-art img { border-radius: 36px; box-shadow: 0 40px 80px -30px var(--accent); }
  .grid { margin-top: 44px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .card { margin: 0; padding: 14px; }
  .card .dl-shot { box-shadow: none; }
  .card figcaption { padding: 16px 6px 6px; font-size: 15px; }
  .card figcaption b { display: block; margin-bottom: 4px; color: var(--ink); font-size: 17px; }
  .safe { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 48px; border-radius: 24px; }
  .safe-k { margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }
  .safe h2 { font-size: clamp(28px, 3.6vw, 42px); font-weight: 800; }
  .get { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 40px; border-radius: 24px; }
  .get h2 { font-size: clamp(26px, 3.2vw, 38px); font-weight: 800; }
  .get-p { margin: 14px 0 26px; }
  .credit { margin: 18px 4px 0; font-size: 14px; color: var(--muted); }
  .credit :global(a) { color: var(--accent-hi); }
  @media (max-width: 860px) {
    .grid, .safe, .get { grid-template-columns: 1fr; }
    .safe, .get { padding: 26px; gap: 22px; }
  }
</style>
