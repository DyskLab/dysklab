---
/*
  FAQ as native <details> (works without JavaScript, keyboard friendly) plus FAQPage
  structured data. Answers may contain simple HTML (links, <code>, <b>).
  JasaWeb layout: heading and a help card on the left, numbered accordion on the right.
  `help` is the card's link (WhatsApp on the home page, the bug report form on products).
*/
import { ui, type Lang } from "../i18n";
interface Props {
  lang: Lang;
  items: { q: string; a: string }[];
  id?: string;
  title?: string;
  help?: { href: string; label: string; external?: boolean };
}
const { lang, items, id = "faq", title = ui[lang].faq, help } = Astro.props;
const s = (a: string, b: string) => (lang === "id" ? a : b);
const strip = (h: string) => h.replace(/<[^>]+>/g, "");
const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: strip(i.a) } })),
};
---
<section class="fq dl-sec dl-gridbg" id={id} aria-labelledby={`${id}-title`}>
  <div class="dl-wrap fq-in">
    <div class="fq-side">
      <p class="dl-label">FAQ</p>
      <h2 class="dl-h2" id={`${id}-title`}>{title}</h2>
      <p class="dl-sub">{s("Belum ada jawabannya di sini? Tanyakan langsung.", "Not answered here? Just ask.")}</p>
      {help && (
        <div class="fq-help">
          <span class="fq-help-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /></svg></span>
          <div><strong>{s("Masih ada pertanyaan?", "Still have a question?")}</strong><small>{s("Gratis, tanpa kewajiban.", "Free, no strings attached.")}</small></div>
          <a href={help.href} {...(help.external ? { target: "_blank", rel: "noopener" } : {})}>{help.label}<span aria-hidden="true">→</span>{help.external && <span class="dl-sr">{ui[lang].newTab}</span>}</a>
        </div>
      )}
    </div>
    <div class="fq-list">
      {items.map((i, n) => (
        <details open={n === 0}>
          <summary><span class="fq-n">{String(n + 1).padStart(2, "0")}</span><span class="fq-q">{i.q}</span><span class="fq-plus" aria-hidden="true"></span></summary>
          <div class="fq-a" set:html={i.a} />
        </details>
      ))}
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .fq-in { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; }
  .fq-side { position: sticky; top: 100px; }
  .fq-help { margin-top: 28px; display: grid; grid-template-columns: auto 1fr; gap: 14px; padding: 20px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); }
  .fq-help-ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-hi); }
  .fq-help-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .fq-help strong { display: block; color: var(--ink); font-size: 15.5px; }
  .fq-help small { font-size: 13.5px; color: var(--muted); }
  .fq-help a {
    grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; padding: 10px 10px 10px 18px; border-radius: 999px;
    background: var(--ink); color: var(--bg); font-weight: 700; font-size: 14.5px; text-decoration: none;
  }
  .fq-help a span[aria-hidden] { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: var(--on-accent); }
  .fq-list { display: grid; gap: 12px; }
  details { border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); transition: border-color 0.2s, background 0.2s; }
  details[open] { border-color: var(--accent-line); background: linear-gradient(180deg, var(--accent-soft), var(--card) 70%); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 16px; padding: 20px 22px; }
  summary::-webkit-details-marker { display: none; }
  .fq-n { flex: none; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; color: var(--muted); }
  details[open] .fq-n { color: var(--accent-hi); }
  .fq-q { flex: 1; font-weight: 700; font-size: 16.5px; line-height: 1.4; color: var(--ink); }
  .fq-plus { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); transition: background 0.2s; }
  .fq-plus::before, .fq-plus::after { content: ""; position: absolute; left: 9px; right: 9px; top: 14px; height: 2px; border-radius: 2px; background: var(--accent-hi); transition: transform 0.2s; }
  .fq-plus::after { transform: rotate(90deg); }
  details[open] .fq-plus { background: var(--accent); }
  details[open] .fq-plus::before { background: var(--on-accent); }
  details[open] .fq-plus::after { transform: rotate(0deg); opacity: 0; }
  .fq-a { padding: 0 22px 20px 58px; font-size: 15.5px; line-height: 1.7; }
  .fq-a :global(p) { margin: 0 0 10px; }
  .fq-a :global(p:last-child) { margin: 0; }
  .fq-a :global(a) { color: var(--accent-hi); text-underline-offset: 3px; }
  .fq-a :global(code) { font-size: 0.88em; padding: 1px 6px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg-2); }
  @media (max-width: 900px) {
    .fq-in { grid-template-columns: 1fr; gap: 32px; }
    .fq-side { position: static; }
  }
  @media (max-width: 560px) {
    summary { padding: 16px; gap: 12px; }
    .fq-a { padding: 0 16px 16px; }
  }
</style>
