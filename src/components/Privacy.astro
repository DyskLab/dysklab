---
/*
  Per-product privacy section: a one-line summary, then what the app keeps, where it
  goes and what (if anything) leaves the device. Items may contain simple HTML.
*/
import { ui, type Lang } from "../i18n";
interface Props {
  lang: Lang;
  summary: string;
  items: { t: string; d: string; ok?: boolean }[];
  note?: string;
  id?: string;
}
const { lang, summary, items, note, id = "privasi" } = Astro.props;
---
<section class="pv dl-sec dl-alt" id={id} aria-labelledby={`${id}-title`}>
  <div class="dl-wrap">
    <div class="dl-head">
      <p class="dl-label">{ui[lang].privacy}</p>
      <h2 class="dl-h2" id={`${id}-title`}>{summary}</h2>
    </div>
    <ul class="pv-list">
      {items.map((i) => (
        <li class:list={["dl-card", "dl-reveal", { "pv-warn": i.ok === false }]}>
          <span class="pv-dot" aria-hidden="true">{i.ok === false ? "!" : "✓"}</span>
          <div><b>{i.t}</b><p set:html={i.d} /></div>
        </li>
      ))}
    </ul>
    {note && <p class="pv-note" set:html={note} />}
  </div>
</section>

<style>
  .pv-list { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .pv-list li { display: flex; gap: 16px; padding: 22px; }
  .pv-dot { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 800; background: var(--accent-soft); color: var(--accent-hi); }
  .pv-warn .pv-dot { background: rgba(245, 158, 11, 0.16); color: #f59e0b; }
  .pv-list b { display: block; color: var(--ink); font-size: 16px; }
  .pv-list p { margin: 4px 0 0; font-size: 14.5px; line-height: 1.6; }
  .pv-list :global(code) { font-size: 0.88em; }
  .pv-list :global(a), .pv-note :global(a) { color: var(--accent-hi); }
  .pv-note { margin: 18px 0 0; font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) { .pv-list { grid-template-columns: 1fr; } }
</style>
