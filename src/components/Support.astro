---
/*
  "Free and open source" block near the end of every open product page: Star on GitHub and
  Buy me a coffee, side by side, each with one honest line on why it helps. No popups,
  no nagging. Star counts only show from 10 up; a 0 or 1 next to the button discourages
  more than it helps.
*/
import { BMC, ui, type Lang } from "../i18n";
import { stars } from "../lib/github";
interface Props { lang: Lang; product: string; repos: { label?: string; repo: string }[]; id?: string }
const { lang, product, repos, id = "dukung" } = Astro.props;
const t = ui[lang];
const counts = await Promise.all(repos.map((r) => stars(r.repo)));
---
<section class="sp" id={id} aria-labelledby={`${id}-title`}>
  <div class="dl-wrap">
    <div class="sp-in dl-featured">
      <div class="sp-copy">
        <p class="sp-k">{t.support}</p>
        <h2 id={`${id}-title`}>{t.supportTitle(product)}</h2>
        <p>{t.supportText}</p>
      </div>
      <div class="sp-actions">
        <div class="sp-card">
          <p>{t.starWhy}</p>
          <div class="sp-stars">
            {repos.map((r, i) => (
              <a class="dl-btn dl-btn-light dl-btn-plain" href={`https://github.com/${r.repo}`} target="_blank" rel="noopener">
                ★ {t.star}{r.label && ` · ${r.label}`}
                {counts[i] !== null && counts[i]! >= 10 && <span class="sp-count">{counts[i]}</span>}
                <span class="dl-sr">{t.newTab}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="sp-card">
          <p>{t.coffeeWhy}</p>
          <a class="dl-btn dl-btn-coffee dl-btn-plain" href={BMC} target="_blank" rel="noopener"><span aria-hidden="true">☕</span>{t.coffee}<span class="dl-sr">{t.newTab}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sp { padding: 24px 0 0; }
  .sp-in { display: grid; grid-template-columns: 1fr 1.15fr; gap: 36px; align-items: center; padding: 40px; border-radius: 24px; }
  .sp-k { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }
  .sp h2 { font-size: clamp(26px, 3vw, 36px); font-weight: 800; }
  .sp-copy > p:last-child { margin: 12px 0 0; color: rgba(255, 255, 255, 0.82); }
  .sp-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .sp-card { display: flex; flex-direction: column; justify-content: space-between; gap: 14px; padding: 18px; border-radius: var(--radius); background: rgba(255, 255, 255, 0.08); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14); }
  .sp-card p { margin: 0; font-size: 14px; color: rgba(255, 255, 255, 0.82); }
  .sp-stars { display: grid; gap: 8px; }
  .sp-card .dl-btn { letter-spacing: 0.02em; text-transform: none; font-size: 15px; white-space: normal; text-align: center; }
  .sp-count { padding: 1px 8px; border-radius: 999px; background: rgba(0, 0, 0, 0.1); font-size: 13px; }
  @media (max-width: 900px) { .sp-in { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .sp-actions { grid-template-columns: 1fr; } .sp-in { padding: 24px; } }
</style>
