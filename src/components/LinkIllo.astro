  .scr .b { background: rgba(124, 92, 255, 0.55); }
  .scr .c { background: rgba(245, 158, 11, 0.5); }
  .kk { display: flex; justify-content: center; gap: 4px; margin-top: 10px; }
  .kk span, .ms kbd { padding: 2px 7px; border-radius: 5px; background: rgba(45, 212, 167, 0.12); border: 1px solid rgba(45, 212, 167, 0.35); color: #5eead4; font: 600 11px Inter, sans-serif; }
  .mon, .sl { width: 84%; display: grid; gap: 9px; }
