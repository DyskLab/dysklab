  .mouse i { position: absolute; left: 50%; top: 12px; width: 4px; height: 12px; margin-left: -2px; border-radius: 2px; background: #2dd4a7; animation: roll 1.2s ease-in-out infinite; }
  @keyframes roll { 50% { transform: translateY(6px); opacity: 0.4; } }
  .ms ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; color: #b8c4c2; font-size: 11px; }
  .pdf small { display: block; margin-top: 4px; font-size: 9px; font-weight: 600; opacity: 0.9; }
  .pill { margin: 10px 0 0; padding: 4px 10px; border-radius: 999px; background: rgba(45, 212, 167, 0.14); border: 1px solid rgba(45, 212, 167, 0.4); color: #5eead4; font-size: 11px; font-weight: 600; white-space: nowrap; }
  .macbox { border: 2px solid #3a4652; background: #121a22; border-radius: 6px; }
  /* lock when the phone goes away */
  .la { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; width: 84%; }
  .la-mac { position: relative; width: 74px; height: 48px; border-radius: 6px; border: 2px solid #3a4652; background: #121a22; display: grid; place-items: center; }
  .la-mac::after { content: ""; position: absolute; left: -7px; right: -7px; bottom: -9px; height: 5px; border-radius: 0 0 4px 4px; background: #3a4652; }
  .la-lock { font-size: 20px; filter: drop-shadow(0 0 10px rgba(45, 212, 167, 0.6)); }
  .la-path { display: flex; justify-content: space-between; }
