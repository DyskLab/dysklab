---
/*
  Small decorative scenes for DyskLink features that have no clean screenshot (mostly
  Android-side features). Pure HTML/CSS in the page's teal palette; aria-hidden because
  the card text already says what the feature does. Text inside follows `lang`.
*/
import type { Lang } from "../i18n";
interface Props { kind: string; lang?: Lang }
const { kind, lang = "id" } = Astro.props;
const t = (id: string, en: string) => (lang === "id" ? id : en);
const bars = [38, 62, 45, 80, 55, 70, 30, 90, 50, 66];
---

<div class={`il il-${kind}`} aria-hidden="true">
  {kind === "remote" && (
    <div class="ph"><div class="pad"><i class="cur"></i></div><div class="row3"><b>◀◀</b><b>▶❚❚</b><b>▶▶</b></div></div>
  )}
  {kind === "ring" && (
    <div class="ringwrap"><span class="w w1"></span><span class="w w2"></span><span class="w w3"></span><div class="ph ph-sm"><span class="bell">🔔</span></div></div>
  )}
  {kind === "tiles" && (
    <div class="qs">
      <div class="t on"><span>📋</span>{t("Kirim clipboard", "Send clipboard")}</div><div class="t"><span>🔒</span>{t("Kunci Mac", "Lock Mac")}</div>
      <div class="t on"><span>☕</span>Keep Awake</div><div class="t wid"><span>💻</span>Mac · 82%</div>
    </div>
  )}
  {kind === "devices" && (
    <div class="devs"><div class="lap"></div><div class="lap lap2"></div><div class="ph ph-xs"></div><svg viewBox="0 0 200 80"><path d="M40 40 Q100 -10 160 40" /><path d="M40 52 Q100 100 172 56" /></svg></div>
  )}
  {kind === "deck" && (
    <div class="deck">{[t("⏺ Rekam", "⏺ Record"), "🎬 Scene 1", "🎙 Mute", "⌘ C", "🔊 +", "▶❚❚", "📸 OBS", "⇧⌘4"].map((b, i) => <b class={`k k${i % 4}`}>{b}</b>)}</div>
  )}
  {kind === "voice" && (
    <div class="voice"><span class="mic">🎙</span><div class="wave">{bars.map((h) => <i style={`height:${h}%`}></i>)}</div>{lang === "id" ? <p>"halo semuanya <em>koma</em> rapat jam tiga <em>titik</em>"</p> : <p>"hi everyone <em>comma</em> meeting at three <em>new line</em>"</p>}</div>
  )}
  {kind === "barcode" && (
    <div class="bc"><div class="code">{Array.from({ length: 28 }, (_, i) => <i style={`width:${(i * 7) % 4 + 1}px`}></i>)}</div><span class="scanline"></span><p>8 991234 567890 ↵</p></div>
  )}
  {kind === "scan" && (
    <div class="doc"><div class="paper"><i></i><i></i><i class="s"></i><i></i><i class="s"></i></div><span class="arrow">→</span><span class="pdf">PDF<small>⌕ {t("bisa dicari", "searchable")}</small></span></div>
  )}
  {kind === "terminal" && (
    <div class="term"><p><b>fanny@mac</b> ~ % htop</p><p class="g">CPU ▇▇▇▅▃▂ 34%</p><p class="g">MEM ▇▇▇▇▅▂ 61%</p><p><b>fanny@mac</b> ~ % <span class="caret"></span></p><div class="keys"><span>esc</span><span>tab</span><span>ctrl</span><span>↑</span><span>↓</span></div></div>
  )}
  {kind === "network" && (
    <div class="gauge"><svg viewBox="0 0 120 70"><path class="bg" d="M10 62 A50 50 0 0 1 110 62" /><path class="fg" d="M10 62 A50 50 0 0 1 92 24" /></svg><b>87<small> Mbps</small></b><span>{t("↓ unduh · ↑ 24 Mbps", "↓ download · ↑ 24 Mbps")}</span></div>
  )}
  {kind === "phonetools" && (
    <div class="stor"><p>{t("Penyimpanan", "Storage")} <b>96 / 128 GB</b></p><div class="bar"><i style="width:44%" class="a"></i><i style="width:20%" class="b"></i><i style="width:11%" class="c"></i></div><ul><li><i class="a"></i>{t("Aplikasi", "Apps")}</li><li><i class="b"></i>{t("Foto", "Photos")}</li><li><i class="c"></i>{t("APK sisa · bisa dihapus", "Leftover APKs · removable")}</li></ul></div>
  )}
  {kind === "browser" && (
    <div class="br"><div class="bt"><i></i><i></i><i></i><span>192.168.1.24:8080</span></div><div class="bb"><p>{t("Masukkan PIN dari HP", "Enter the PIN from the phone")}</p><div class="pin"><b>7</b><b>3</b><b>0</b><b>•</b></div></div></div>
  )}
  {kind === "prayer" && (
    <div class="pr"><div><small>{t("Berikutnya", "Next")}</small><b>Ashar</b><span>15:12</span></div><div class="wx"><span>⛅</span><b>32°</b><small>Bandung</small></div></div>
  )}
  {kind === "charge" && (
    <div class="bat"><div class="cell"><i style="width:80%"></i><span>80%</span></div><p>🔔 {t("Baterai sudah 80%, cabut charger", "Battery at 80%, unplug the charger")}</p></div>
  )}
  {kind === "launcher" && (
    <div class="ln"><div class="q">⌕ 10 km to mi</div><div class="r on"><span>=</span>6,21 mi</div><div class="r"><span>🧭</span>Safari</div><div class="r"><span>📄</span>{t("laporan.pdf", "report.pdf")}</div></div>
  )}
  {kind === "layout" && (
    <div class="lay"><div class="scr"><i class="a"></i><i class="b"></i><i class="c"></i></div><div class="kk"><span>⌃</span><span>⌥</span><span>←</span></div></div>
  )}
  {kind === "monitor" && (
    <div class="mon">{[["CPU", 34], [t("Memori", "Memory"), 61], ["Disk", 72], [t("Jaringan", "Network"), 18]].map(([l, v]) => <div class="m"><span>{l}</span><div><i style={`width:${v}%`}></i></div><b>{v}%</b></div>)}</div>
  )}
  {kind === "brightness" && (
    <div class="sl">{[["☀ MacBook", 70], ["☀ Monitor DDC", 45], ["🔊 Speaker", 60]].map(([l, v]) => <div class="s"><span>{l}</span><div><i style={`width:${v}%`}></i></div></div>)}</div>
  )}
  {kind === "mouse" && (
    <div class="ms"><div class="mouse"><i></i></div><ul><li><kbd>⇧</kbd> + scroll · {t("geser samping", "sideways")}</li><li><kbd>⌥</kbd> + scroll · zoom</li><li><kbd>⌃</kbd> + scroll · volume</li></ul></div>
  )}
  {kind === "lockaway" && (
    <div class="la"><div class="la-mac"><span class="la-lock">🔒</span></div><div class="la-path"><i></i><i></i><i></i><i></i><i></i></div><div class="la-ph"></div><p>{t("HP pergi 30 dtk → Mac terkunci", "Phone gone 30 s → Mac locks")}</p></div>
  )}
  {kind === "usb" && (
    <div class="usb"><div class="usb-mac"></div><svg viewBox="0 0 120 40"><path d="M2 20 C 40 20, 50 34, 80 26 S 110 18, 118 20" /></svg><div class="usb-ph"><span>USB</span></div><p class="pill">⚡ {t("Tersambung lewat USB", "Connected over USB")}</p></div>
  )}
  {kind === "wake" && (
    <div class="wk"><div class="wk-mac"><span>z</span><span>z</span><span>z</span></div><div class="wk-waves"><i></i><i></i><i></i></div><div class="wk-ph"><b>Wake Mac</b></div></div>
  )}
  {kind === "photosync" && (
    <div class="ps"><div class="ps-ph"><i></i><i></i><i></i><i></i></div><div class="ps-fly"><i></i><i></i></div><div class="ps-dir"><span>📁</span><small>Pictures › DyskLink</small></div></div>
  )}
  {kind === "gallery" && (
    <div class="gal"><div class="gal-bar"><i></i><i></i><i></i><span>{t("Galeri HP", "Phone gallery")}</span></div><div class="gal-grid">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <i class={`g${i}`}>{i === 2 && "▶"}</i>)}</div></div>
  )}
  {kind === "sound" && (
    <div class="snd"><div class="snd-mac">🔊</div><div class="snd-mid"><p><span>Mac</span> → <span>{t("HP", "Phone")}</span></p><div class="eq">{bars.map((h) => <i style={`height:${h}%`}></i>)}</div><p><span>{t("HP", "Phone")}</span> → <span>Mac</span></p></div><div class="snd-ph">🎧</div></div>
  )}
  {kind === "search" && (
    <div class="srch"><div class="srch-q">⌕ <b>0812 34</b><i class="caret"></i></div><div class="srch-r"><span class="av">AL</span><div><b>Ayu Lestari</b><small>+62 <mark>812-34</mark>56-789</small></div></div><div class="srch-r"><span class="av av2">✉</span><div><b>{t("SMS · Budi", "SMS · Budi")}</b><small>{t("kode dari", "code from")} <mark>0812 34</mark>…</small></div></div></div>
  )}
  {kind === "macscreen" && (
    <div class="msc"><div class="msc-ph"><div class="msc-scr"><div class="msc-bar"></div><div class="msc-win"></div><div class="msc-win msc-w2"></div><span class="tap"></span></div></div><p>{t("ketuk · ketik · scroll", "tap · type · scroll")}</p></div>
  )}
  {kind === "display2" && (
    <div class="d2"><div class="d2-mac"><div class="d2-win"></div></div><div class="d2-ph"><div class="d2-win d2-moving"></div></div><span class="d2-arrow">→</span></div>
  )}
  {kind === "camera" && (
    <div class="cam"><div class="cam-win"><div class="cam-view"><span class="cam-face"></span></div><div class="cam-tools"><b>⟲ {t("Lensa", "Lens")}</b><b>🔦</b><b>⇋</b><b>📌</b></div></div><span class="cam-tag">● LIVE</span></div>
  )}
  {kind === "obs" && (
    <div class="obs"><div class="obs-prev"><div class="obs-cam"></div><div class="obs-phone"></div><span>● REC</span></div><ul><li class="on">📷 DyskLink Camera</li><li>📱 {t("Layar HP", "Phone screen")}</li><li>🖥 Window Capture</li></ul></div>
  )}
  {kind === "gamekeys" && (
    <div class="gk"><div class="gk-ph"><div class="gk-joy"><span>W</span><span>A</span><span>S</span><span>D</span><i></i></div><b class="gk-k k-j">J</b><b class="gk-k k-sp">␣</b><b class="gk-k k-r">R</b></div></div>
  )}
  {kind === "airmouse" && (
    <div class="am"><div class="am-scr"><svg viewBox="0 0 160 70"><path d="M20 50 Q 60 10 100 30 T 140 22" /></svg><span class="am-dot"></span></div><div class="am-ph"><b>{t("Tahan untuk menunjuk", "Hold to point")}</b></div></div>
  )}
  {kind === "notchphone" && (
    <div class="np"><div class="np-ph"><p class="np-h">Notch</p><div class="np-t"><i class="done"></i><s>{t("Kirim laporan", "Send report")}</s></div><div class="np-t"><i></i>{t("Telepon Budi", "Call Budi")}</div><div class="np-row"><span>💧 5/8</span><span>⏱ 18:42</span></div></div><p class="np-dnd">🌙 {t("Jangan Ganggu saat fokus", "Do Not Disturb while focusing")}</p></div>
  )}
  {kind === "widgets" && (
    <div class="wg">
      <div class="wg-w wg-note"><small>{t("Catatan", "Note")}</small><p>Wi-Fi: dysk-guest</p></div>
      <div class="wg-w wg-todo"><small>Todo</small><p><i class="done"></i><s>{t("Belanja", "Groceries")}</s></p><p><i></i>{t("Rapat 15.00", "Meeting 3 PM")}</p></div>
      <div class="wg-w wg-pomo"><b>24:12</b><small>💧 5 / 8</small></div>
      <div class="wg-w wg-media"><span class="art"></span><div><b>Paper Birds</b><small>⏮ ⏯ ⏭</small></div></div>
      <div class="wg-w wg-bat"><span style="--v:82">💻</span><span style="--v:64">📱</span><span style="--v:35">📱</span></div>
      <div class="wg-w wg-btn"><i>📋</i><i>🔒</i><i>☕</i><i>🔔</i></div>
    </div>
  )}
  {kind === "textcap" && (
    <div class="tc"><div class="tc-doc"><i></i><i></i><i class="s"></i><i></i><i class="s"></i><span class="tc-sel"></span></div><div class="tc-side"><div class="kk"><span>⌃</span><span>⌘</span><span>O</span></div><p class="pill">✓ {t("Teks disalin", "Text copied")}</p></div></div>
  )}
  {kind === "lyrics" && (
    <div class="ly"><div class="ly-top"><span class="ly-yt">▶</span><div><b>Paper Birds</b><small>YouTube · Firefox</small></div></div><p class="dim">{t("dan kita terbang pelan", "and we drift along slowly")}</p><p class="ly-cur">{t("di atas kota yang tidur", "over the sleeping city")}</p><p class="dim">{t("sampai pagi datang", "until the morning comes")}</p><small class="ly-src">LRCLIB · {t("opsional", "optional")}</small></div>
  )}
  {kind === "update" && (
    <div class="up"><p class="up-h"><span>⬆</span>{t("DyskLink baru tersedia", "A new DyskLink is out")}</p><div class="up-bar"><i></i></div><p class="up-ok">✓ {t("Sertifikat sama", "Same certificate")}</p><b class="up-btn">Install and restart</b></div>
  )}
</div>

<style>
  .il { position: relative; height: 100%; display: grid; place-items: center; overflow: hidden; color: #eef7f4; font: 500 12px/1.3 Inter, sans-serif;
    background: radial-gradient(80% 90% at 50% 0%, rgba(45, 212, 167, 0.16), transparent 70%), #0b1016; }
  .ph { width: 92px; height: 132px; border-radius: 18px; border: 2px solid #2a323c; background: #111820; padding: 8px; box-sizing: border-box; display: grid; gap: 6px; align-content: start; }
  .pad { position: relative; height: 78px; border-radius: 10px; background: rgba(45, 212, 167, 0.1); border: 1px solid rgba(45, 212, 167, 0.3); }
  .cur { position: absolute; left: 30px; top: 26px; width: 14px; height: 14px; border-radius: 50%; background: #2dd4a7; box-shadow: 0 0 16px #2dd4a7; animation: drift 3s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate(22px, 18px); } }
  .row3 { display: flex; justify-content: space-between; font-size: 9px; color: #5eead4; }
  .ringwrap { position: relative; display: grid; place-items: center; }
  .w { position: absolute; width: 90px; height: 90px; border-radius: 50%; border: 1.5px solid rgba(45, 212, 167, 0.5); animation: wave 2.4s ease-out infinite; }
  .w2 { animation-delay: 0.8s; } .w3 { animation-delay: 1.6s; }
  @keyframes wave { from { transform: scale(0.6); opacity: 1; } to { transform: scale(2); opacity: 0; } }
  .ph-sm { width: 64px; height: 100px; place-items: center; align-content: center; }
  .bell { font-size: 26px; animation: shake 0.5s ease-in-out infinite alternate; }
  @keyframes shake { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
  .qs { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; width: 82%; }
  .qs .t { display: flex; align-items: center; gap: 7px; padding: 9px 10px; border-radius: 14px; background: #1a222b; font-size: 11px; }
  .qs .t.on { background: #2dd4a7; color: #032119; font-weight: 600; }
  .qs .wid { background: #13202a; border: 1px solid rgba(45, 212, 167, 0.35); }
  .devs { position: relative; width: 210px; height: 110px; }
  .devs svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: #2dd4a7; stroke-width: 1.5; stroke-dasharray: 4 5; animation: dash 1.5s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -18; } }
  .lap { position: absolute; left: 0; top: 30px; width: 62px; height: 40px; border-radius: 5px; border: 2px solid #3a4652; background: #121a22; }
  .lap::after { content: ""; position: absolute; left: -6px; right: -6px; bottom: -8px; height: 5px; border-radius: 0 0 4px 4px; background: #3a4652; }
  .lap2 { left: auto; right: 6px; top: 6px; }
  .ph-xs { position: absolute; right: 18px; bottom: 0; width: 28px; height: 46px; border-radius: 7px; padding: 0; }
  .deck { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; width: 86%; }
  .k { display: grid; place-items: center; height: 42px; border-radius: 10px; font-size: 10px; font-weight: 600; text-align: center; }
  .k0 { background: #2dd4a7; color: #032119; } .k1 { background: #7c5cff; } .k2 { background: #ef4444; } .k3 { background: #1f2a35; }
  .voice { width: 86%; text-align: center; }
  .mic { font-size: 22px; }
  .wave { display: flex; align-items: center; justify-content: center; gap: 4px; height: 40px; margin: 6px 0; }
  .wave i { width: 5px; border-radius: 3px; background: #2dd4a7; animation: bar 1s ease-in-out infinite alternate; }
  .wave i:nth-child(odd) { animation-delay: 0.3s; }
  @keyframes bar { to { transform: scaleY(0.4); } }
  .voice p { margin: 0; color: #8fa3a0; font-size: 11.5px; }
  .voice em { color: #5eead4; font-style: normal; }
  .bc { position: relative; padding: 14px 18px 8px; border-radius: 10px; background: #f4f7f6; text-align: center; }
  .code { display: flex; gap: 2px; height: 54px; }
  .code i { background: #0b1016; }
  .scanline { position: absolute; left: 8px; right: 8px; top: 14px; height: 2px; background: #ef4444; box-shadow: 0 0 10px #ef4444; animation: scan 1.8s ease-in-out infinite alternate; }
  @keyframes scan { to { top: 66px; } }
  .bc p { margin: 6px 0 0; color: #0b1016; font: 600 11px ui-monospace, Menlo, monospace; }
  .doc { display: flex; align-items: center; gap: 14px; }
  .paper { width: 70px; height: 92px; padding: 10px 9px; box-sizing: border-box; background: #f4f7f6; border-radius: 4px; transform: rotate(-6deg); display: grid; gap: 7px; align-content: start; outline: 2px dashed #2dd4a7; outline-offset: 5px; }
  .paper i { height: 5px; border-radius: 3px; background: #b8c4c2; }
  .paper i.s { width: 60%; }
  .arrow { color: #5eead4; font-size: 20px; }
  .pdf { padding: 18px 12px; border-radius: 8px; background: #ef4444; font-weight: 700; }
  .term { width: 86%; padding: 12px 14px; border-radius: 10px; background: #05080c; border: 1px solid #1f2a35; font: 11px/1.6 ui-monospace, Menlo, monospace; }
  .term p { margin: 0; }
  .term b { color: #5eead4; font-weight: 600; }
  .term .g { color: #8fa3a0; }
  .caret { display: inline-block; width: 7px; height: 12px; vertical-align: -2px; background: #2dd4a7; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term .keys { display: flex; gap: 4px; margin-top: 8px; }
  .term .keys span { padding: 1px 6px; border-radius: 4px; background: #1a222b; color: #cfe; }
  .gauge { text-align: center; }
  .gauge svg { width: 130px; display: block; margin: 0 auto -18px; fill: none; stroke-width: 9; stroke-linecap: round; }
  .gauge .bg { stroke: #1f2a35; } .gauge .fg { stroke: #2dd4a7; }
  .gauge b { font: 700 24px Sora, sans-serif; }
  .gauge small { font-size: 11px; color: #8fa3a0; }
  .gauge span { display: block; color: #8fa3a0; font-size: 11px; }
  .stor { width: 84%; }
  .stor p { margin: 0 0 8px; color: #8fa3a0; }
  .stor p b { color: #eef7f4; }
  .stor .bar { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: #1f2a35; }
  .stor ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 4px; color: #8fa3a0; font-size: 11px; }
  .stor li { display: flex; align-items: center; gap: 6px; }
  .stor li i { width: 8px; height: 8px; border-radius: 2px; }
  .a { background: #2dd4a7; } .b { background: #7c5cff; } .c { background: #f59e0b; }
  .br { width: 84%; border-radius: 10px; overflow: hidden; border: 1px solid #2a323c; background: #111820; }
  .bt { display: flex; align-items: center; gap: 4px; padding: 6px 8px; background: #1a222b; }
  .bt i { width: 7px; height: 7px; border-radius: 50%; background: #3a4652; }
  .bt span { margin-left: 6px; padding: 2px 8px; border-radius: 5px; background: #0b1016; color: #8fa3a0; font-size: 10px; }
  .bb { padding: 14px; text-align: center; }
  .bb p { margin: 0 0 8px; color: #8fa3a0; }
  .pin { display: flex; justify-content: center; gap: 5px; }
  .pin b { width: 24px; height: 30px; display: grid; place-items: center; border-radius: 6px; border: 1px solid rgba(45, 212, 167, 0.5); font: 600 15px Sora, sans-serif; }
  .pr { display: flex; gap: 22px; align-items: center; padding: 14px 18px; border-radius: 18px; background: #000; }
  .pr small { display: block; color: #8fa3a0; font-size: 10.5px; }
  .pr b { display: block; font: 700 22px Sora, sans-serif; }
  .pr span { color: #5eead4; font-weight: 600; }
  .wx { text-align: center; padding-left: 20px; border-left: 1px solid #1f2a35; }
  .wx span { font-size: 22px; color: inherit; }
  .bat { text-align: center; }
  .cell { position: relative; width: 120px; height: 46px; margin: 0 auto; padding: 4px; box-sizing: border-box; border: 2.5px solid #5eead4; border-radius: 10px; }
  .cell::after { content: ""; position: absolute; right: -9px; top: 13px; width: 5px; height: 14px; border-radius: 0 3px 3px 0; background: #5eead4; }
  .cell i { display: block; height: 100%; border-radius: 5px; background: linear-gradient(90deg, #2dd4a7, #a7f3d0); }
  .cell span { position: absolute; inset: 0; display: grid; place-items: center; font: 700 15px Sora, sans-serif; color: #032119; }
  .bat p { margin: 12px 0 0; padding: 6px 10px; border-radius: 8px; background: #1a222b; font-size: 11px; }
  .ln { width: 84%; padding: 8px; border-radius: 12px; background: rgba(30, 38, 48, 0.9); border: 1px solid #2a323c; display: grid; gap: 4px; }
  .ln .q { padding: 7px 9px; border-radius: 8px; background: #0b1016; font-size: 12.5px; }
  .ln .r { display: flex; gap: 8px; padding: 5px 9px; border-radius: 7px; color: #b8c4c2; }
  .ln .r.on { background: #2dd4a7; color: #032119; font-weight: 600; }
  .ln .r span { width: 14px; text-align: center; }
  .lay { text-align: center; }
  .scr { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; width: 170px; height: 96px; padding: 4px; box-sizing: border-box; border: 2px solid #3a4652; border-radius: 6px; }
