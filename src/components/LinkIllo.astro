  .la-path i:nth-child(2) { animation-delay: 0.2s; } .la-path i:nth-child(3) { animation-delay: 0.4s; } .la-path i:nth-child(4) { animation-delay: 0.6s; } .la-path i:nth-child(5) { animation-delay: 0.8s; }
  @keyframes fade { 50% { opacity: 0.15; } }
  .la-ph { width: 28px; height: 48px; border-radius: 7px; border: 2px solid #2a323c; background: #111820; opacity: 0.55; transform: rotate(10deg); }
  .la p { grid-column: 1 / -1; margin: 6px 0 0; text-align: center; color: #8fa3a0; font-size: 11px; }
  /* usb */
  .usb { display: grid; grid-template-columns: auto 110px auto; align-items: center; justify-items: center; }
  .usb-mac { position: relative; width: 70px; height: 46px; border-radius: 6px; border: 2px solid #3a4652; background: #121a22; }
  .usb-mac::after { content: ""; position: absolute; left: -7px; right: -7px; bottom: -9px; height: 5px; border-radius: 0 0 4px 4px; background: #3a4652; }
  .usb svg { width: 110px; height: 40px; fill: none; stroke: #5eead4; stroke-width: 3; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(45, 212, 167, 0.6)); }
  .usb-ph { width: 36px; height: 62px; border-radius: 8px; border: 2px solid #2a323c; background: #111820; display: grid; place-items: end center; padding-bottom: 6px; box-sizing: border-box; }
  .usb-ph span { font-size: 8px; font-weight: 700; color: #5eead4; }
